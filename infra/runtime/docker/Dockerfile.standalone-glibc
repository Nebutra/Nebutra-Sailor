# Same as Dockerfile.standalone, but glibc. kuanlan's 开拍 route loads sharp;
# CI traces the linux-x64 native, which Alpine/musl cannot open.
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
WORKDIR /app

ARG APP_WORKSPACE=apps/forge
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=8080
ENV APP_WORKSPACE=${APP_WORKSPACE}

COPY --chown=node:node . .
USER node
EXPOSE 8080
CMD ["sh", "-c", "node ${APP_WORKSPACE}/server.js"]
