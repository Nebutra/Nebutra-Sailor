# Prebuilt Next standalone bundle. CI copies .next/standalone + static + public
# into the build context; this image only runs the server on 0.0.0.0.
FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2
WORKDIR /app

ARG APP_WORKSPACE=apps/forge
# forge only: grants the non-root `node` user cap_net_bind_service so
# forge-dns-leak's embedded authority can bind UDP/TCP :53. A no-op for every
# other app's build (default false) — see infra/fly/forge.toml.
ARG ENABLE_NET_BIND_CAP=false
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=8080
ENV APP_WORKSPACE=${APP_WORKSPACE}

COPY --chown=node:node . .
RUN if [ "$ENABLE_NET_BIND_CAP" = "true" ]; then \
      apk add --no-cache libcap && \
      setcap 'cap_net_bind_service=+ep' "$(readlink -f "$(command -v node)")" && \
      apk del libcap; \
    fi
USER node
EXPOSE 8080
EXPOSE 53/udp
EXPOSE 53/tcp
# ENABLE_FORGE_DNS_LEAK (runtime env, set in infra/fly/forge.toml) backgrounds
# the DNS leak-test authority + its localhost control API before exec'ing the
# Next server, so both share one container/Machine. Every other app leaves it
# unset and this is exactly the previous single-process CMD.
CMD ["sh", "-c", "if [ \"$ENABLE_FORGE_DNS_LEAK\" = \"true\" ]; then node --experimental-strip-types --no-warnings=ExperimentalWarning packages/ai/forge-dns-leak/src/cli.ts & fi; exec node ${APP_WORKSPACE}/server.js"]
