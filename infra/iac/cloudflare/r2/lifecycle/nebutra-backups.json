{
  "rules": [
    {
      "id": "abort-stale-multipart-uploads",
      "enabled": true,
      "conditions": { "prefix": "" },
      "abortMultipartUploadsTransition": {
        "condition": { "type": "Age", "maxAge": 86400 }
      }
    },
    {
      "id": "expire-backups-after-30-days",
      "enabled": true,
      "conditions": { "prefix": "" },
      "deleteObjectsTransition": {
        "condition": { "type": "Age", "maxAge": 2592000 }
      }
    }
  ]
}
