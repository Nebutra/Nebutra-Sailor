# Include the actual API/data packages; upstream's Dockerfile copies only *.py.
FROM ghcr.io/astral-sh/uv:0.11.6 AS uv
FROM python:3.12-slim
COPY --from=uv /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl jq && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
ENV UV_NO_CACHE=1 UV_DEFAULT_INDEX=https://pypi.org/simple
RUN uv sync --frozen --no-dev && useradd --create-home connector && chown -R connector:connector /app
USER connector
ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8080
# Bound socket connects; directory warm-up otherwise blocks the listening port.
CMD ["python", "nebutra-entrypoint.py"]
