# One Machine for the whole KCQ surface: nginx (public, 8080) plus the GOTDX,
# Binance depth and TradingView connectors on loopback-adjacent ports, under a
# supervisor that restarts each independently. See
# docs/ops/nebutra/2026-10-09-kcq-consolidation.md.
#
# Build context (staged by deploy-kcq-fly.yml):
#   html/ gotdx/ python/ nginx.conf kcq-supervisor.py kcq-python-entrypoint.py smoke-kcq-connector.sh

FROM golang:1.27-alpine AS gotdx
WORKDIR /src
COPY gotdx/ .
RUN CGO_ENABLED=0 go build -trimpath -o /out/kcq-tdx ./services/tdx-api \
 && CGO_ENABLED=0 go build -trimpath -o /out/kcq-binance ./services/binance-api

FROM ghcr.io/astral-sh/uv:0.11.6 AS uv

# Same base as the runtime stage so the venv's interpreter path stays valid.
FROM python:3.12-slim AS python-build
COPY --from=uv /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/kcq-python
COPY python/ .
# Preserve locked versions and hashes; only the package mirror origin changes
# (the upstream lock points at a mainland mirror the remote builder cannot use).
RUN sed -i 's|https://mirrors.aliyun.com/pypi/simple/|https://pypi.org/simple|g; s|https://mirrors.aliyun.com/pypi/packages/|https://files.pythonhosted.org/packages/|g' uv.lock
ENV UV_NO_CACHE=1 UV_DEFAULT_INDEX=https://pypi.org/simple
RUN uv sync --frozen --no-dev

FROM python:3.12-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends nginx ca-certificates curl jq tzdata \
 && rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf \
 && useradd --create-home connector \
 && mkdir -p /var/lib/kcq/tdx /var/lib/kcq/python \
 && chown -R connector:connector /var/lib/kcq \
 && ln -sf /dev/stdout /var/log/nginx/access.log && ln -sf /dev/stderr /var/log/nginx/error.log

COPY --from=gotdx /out/kcq-tdx /out/kcq-binance /usr/local/bin/
COPY --from=python-build --chown=connector:connector /opt/kcq-python /opt/kcq-python
COPY nginx.conf /etc/nginx/conf.d/kcq.conf
COPY html/ /usr/share/nginx/html/
COPY kcq-supervisor.py /usr/local/bin/kcq-supervisor
COPY kcq-python-entrypoint.py /opt/kcq-python/nebutra-entrypoint.py
COPY smoke-kcq-connector.sh /usr/local/bin/nebutra-smoke.sh

ENV PATH="/opt/kcq-python/.venv/bin:$PATH"
EXPOSE 8080
CMD ["python", "/usr/local/bin/kcq-supervisor"]
