# Claude Code
.claude/

# Dependencies
node_modules
.pnpm-store

# Build outputs
dist
.next
.open-next
.wrangler
.turbo
out
storybook-static
# Local deploy staging tree (pnpm deploy --prod output). Untracked build
# artifact; Biome reads this file (biome.json vcs.useIgnoreFile), so leaving it
# out made `pnpm lint` fail on generated server bundles and short-circuited
# every guard chained after `biome check`.
.deploy

# Environment
.env
.env.*
!.env.example
!*.template
.wrangler-secrets.json

# DNS inventory dumps
infra/ops/dns/*
!infra/ops/dns/README.md
!infra/ops/dns/.gitignore
!infra/ops/dns/topology.defaults.yaml

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage
e2e/test-results
e2e/playwright-report
playwright-report
test-results

# Prisma
packages/db/generated

# Python
__pycache__
*.pyc
.venv
venv
.pytest_cache
.coverage
.ruff_cache

# Rust
target

# Brand assets (synced from packages/brand)
apps/*/public/brand
apps/*/public/brand-compliant
apps/*/public/favicon.ico
# tsekaluk-dev is deployed standalone on Vercel (turbo --filter skips root build:sync)
# so brand assets must be committed directly
!apps/tsekaluk-dev/public/brand
!apps/tsekaluk-dev/public/brand-compliant

# White-label customization (fork users)
brand.config.ts
brand.config/

# Misc
*.tsbuildinfo
artifacts/
# Source dir, not a build artifact — feature specimen components.
!apps/landing/src/components/landing/features/artifacts/
!apps/landing/src/components/landing/features/artifacts/**
.vercel

# Generated API client artifacts — produced by pnpm generate:api-types
# Note: types.generated.ts stub is committed so typecheck works before generation;
# a real generation run will overwrite it (treat modified state as expected).
apps/api-gateway/openapi.json

# npm auth tokens — MUST NEVER be committed (auth tokens leak secrets).
# Root .npmrc stays tracked (pnpm public-hoist-pattern); this blocks new
# .npmrc files in subdirs commonly created by tooling to hold bypass tokens.
**/.npmrc
!.npmrc
!.npmrc.example

# Fumadocs generated content — never commit. Empty stubs in this dir block
# subsequent fumadocs-mdx regeneration (it skips files that already exist),
# which silently broke design-docs typecheck for weeks.
apps/*/.source/

# Playwright MCP browser session logs
.playwright-mcp/

# LLM gateway debug traces — local-only call logs, never commit
**/.nebutra/debug/

# tsup temp bundled configs — auto-generated next to tsup.config.ts on build,
# safe to delete, never commit
**/tsup.config.bundled*.mjs

# Brainstorm visual companion scratch
.superpowers/

# Verification scratch — throwaway playwright harnesses used to render a component
# and look at it before a change lands. Ignored rather than tidied away by hand
# because biome honours the ignore file, so an unformatted scratch script here
# would otherwise fail `pnpm lint` and gate the whole pipeline on a file nobody
# intended to keep.
scratch-verify/

# Competitor research: committed evidence lives in research/competitors/*/evidence/
# (webp ≤ 150 KB per state). Full-size captures, DOM dumps and HAR stay local.
# Regenerate with scripts/research-screenshot.mjs or the owner-assisted Chrome session.
research/**/raw/
docs/research/

# Full CJK source faces downloaded by subset:cjk. Generated OFL woff2 files
# under packages/design/fonts/generated/ ARE committed so next/font/local works
# on a clean clone without fontTools.
# MiSans may not be redistributed as a font file (see packages/design/fonts/NOTICE-FONTS.md);
# its subsets live on the asset CDN, never in this public repo.
packages/design/fonts/generated/misans-*.woff2
packages/design/fonts/vendor/misans/*.zip
packages/design/fonts/vendor/**/*.ttf
packages/design/fonts/vendor/**/*.otf

# Trellis research evidence: keep the reports and data dumps reviewable,
# never commit the screenshot corpora (117 MB for the 302-parity round alone).
.trellis/tasks/*/research/shots/
.trellis/tasks/*/research/shots-*/
.trellis/tasks/*/research/*.png

# Trellis / Codex machine state, and the locally-generated trellis skills.
#
# Everything here is regenerated per machine and belongs to no commit. main
# tracks zero files under .trellis/ and .codex/, but only the research
# screenshots above were ignored — so `git add -A` swept the rest in. That is
# how PR #554 arrived carrying 1,677 .trellis files: 144,261 of the 146,208
# lines in its diff, which buried a real capability-stats drift under noise and
# failed its Test and CodeQL checks on content unrelated to the change.
#
# .trellis/tasks/ stays trackable on purpose — the block above exists so task
# reports can be reviewed, minus their screenshot corpora.
.trellis/.runtime/
.trellis/.developer
.trellis/scripts/
.trellis/spec/
.trellis/workspace/
.trellis/agents/
.codex/
.agents/skills/trellis-*/

# Local working copies of this repo (multi-agent / worktree scratch).
#
# These are full nebutra-sailor trees sitting inside the repo — same
# package.json name, no .git of their own. They are not tracked, but the
# architecture suite walks the filesystem rather than git, so it counts them as
# repo content: template-boundary reported 4021 files "carrying a Nebutra
# identifier" (every one of them inside these four), and type-hygiene-ratchet
# measured 249 `as any` against a baseline of 59.
#
# CI is green because it checks out a clean tree. Only local runs of
# `pnpm test` / `pnpm template:check` see the phantom failures, which is worse:
# the guard that fires is the one nobody trusts.
#
# Ignoring is not deleting. Remove them yourself when you are done with them.
/loggerhead/
/pompano/
/seasnake/
/yabby/

# Lighthouse CI local run output.
/.lighthouseci/
