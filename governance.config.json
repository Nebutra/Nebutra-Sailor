  "microcopyRules": {
    "scanRoots": ["apps/web/src"],
    "excludePaths": [
      "/api/",
      "\\.test\\.tsx?$",
      "/__tests__/",
      "/storybook/src/stories/",
      "/sailor-docs/"
    ],
    "bannedPatterns": [
      {
        "pattern": "暂无",
        "label": "禁七: 空白状态禁用「暂无」"
      },
      {
        "pattern": "No [A-Za-z].*(yet|available)",
        "label": "禁七: empty state lacks a 母题 (\"No X yet/available\")"
      },
      {
        "pattern": "赋能|闭环|抓手|颗粒度|打法|系统检测到|请您",
        "label": "禁四: LinkedIn/corporate-speak (赋能/闭环/抓手/颗粒度/打法/系统检测到/请您)"
      },
      {
        "pattern": "加油|你能行|冲鸭|梦想成真",
        "label": "禁一 (partial): over-incentive words (加油/你能行/冲鸭/梦想成真)"
      }
    ],
    "allowlist": []
  },
  "inertDimensions": {
    "description": "Dimensions every Brand Package declares that no shipped code reads, measured 2026-07-31 by compiling the real Tailwind pipeline rather than reading source. A skin can override these forever without moving a pixel. Shrink-only: give a dimension a consumer and delete its entry. This list records what was already true when the guard was written — it is not somewhere to park a new dimension so the gate goes green. spacing and controls were removed 2026-07-31: both were false positives from a detector bug (scripts/lint-inert-dimensions.mjs required var(--x) to close immediately, but every real caller writes a CSS fallback, var(--spacing-md, ...)). Compiling apps/web's real globals.css with @tailwindcss/node confirmed --spacing-md/--spacing-lg vary per brand (consumed by apps/web/src/components/theme-playground) and --control-height-* is read at 58 call sites in packages/design/ui/src/primitives/button-variants.ts and switch.tsx, density-driven via packages/design/tokens/src/brand-package/emit-css.ts. Both dimensions were already wired; only the guard was blind to it.",
    "known": []
  }
}
