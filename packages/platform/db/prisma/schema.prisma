}

// ============================================
// OAuth 2.0 / OpenID Connect Identity Provider
// ============================================

enum OAuthClientType {
  CONFIDENTIAL // Server-side apps (have a secret)
  PUBLIC // SPAs, mobile apps, CLIs (no secret)

  @@schema("public")
}

enum OAuthClientStatus {
  ACTIVE
  SUSPENDED
  REVOKED

  @@schema("public")
}

// Third-party applications registered in Nebutra's ecosystem
model OAuthClient {
  id               String            @id @default(cuid())
  clientId         String            @unique @map("client_id")
  /// Argon2/bcrypt hash — verifies a secret the caller already holds. One-way,
  /// so it cannot answer "what is this client's secret", which is what the
  /// token endpoint needs when the client authenticates with client_secret_basic.
  clientSecretHash String?           @map("client_secret_hash")
  /// @nebutra/vault EncryptedSecret envelope, for confidential clients whose
  /// secret must be RETRIEVABLE rather than merely verifiable.
  ///
  /// The hash above cannot serve that: oidc-provider has to hand the configured
  /// secret to its own client-auth check, so a one-way digest leaves the client
  /// unusable — the Prisma adapter refuses to serve it rather than inventing one.
  /// That is why an external relying party such as Cloudflare Access, whose OIDC
  /// connector requires a client_secret and does not support private_key_jwt,
  /// could not federate with this issuer at all.
  ///
  /// Envelope encryption, not plaintext: the DEK is wrapped by a KEK held in AWS
  /// KMS (or derived via local HKDF in development), so the database alone does
  /// not yield the secret. Both fields are kept — the hash for paths that only
  /// verify, this for the token endpoint.
  clientSecretEnvelope Json?         @map("client_secret_envelope")
  type             OAuthClientType   @default(CONFIDENTIAL)
  status           OAuthClientStatus @default(ACTIVE)
  name             String
  description      String?           @db.Text
  logoUrl          String?           @map("logo_url")
  websiteUrl       String?           @map("website_url")
  privacyPolicyUrl String?           @map("privacy_policy_url")
  tosUrl           String?           @map("tos_url")

  // OAuth configuration
  redirectUris            String[] @map("redirect_uris")
  allowedScopes           String[] @default(["openid", "profile"]) @map("allowed_scopes")
  grantTypes              String[] @default(["authorization_code"]) @map("grant_types")
  responseTypes           String[] @default(["code"]) @map("response_types")
  tokenEndpointAuthMethod String   @default("client_secret_basic") @map("token_endpoint_auth_method")

  // Rate limiting & security
  rateLimitRpm    Int @default(60) @map("rate_limit_rpm")
  accessTokenTtl  Int @default(3600) @map("access_token_ttl")
  refreshTokenTtl Int @default(2592000) @map("refresh_token_ttl")

  // Ownership
  // AUDIT(no-tenant): platform-level clients (the admin control plane, ops
  // tooling) belong to no tenant. There is no "platform tenant" to point at —
  // Tenant is a supertype of Organization and Individual and must link to one
  // of them — so forcing a value here would mean inventing a fake tenant row.
  // Nullable is the honest shape; tenant-owned clients still set it.
  tenantId    String? @map("tenant_id")
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorizations OAuthAuthorization[]
  accessTokens   OAuthAccessToken[]

  @@index([tenantId])
  @@index([status])
  @@map("oauth_clients")
  @@schema("public")
}

// User consent records — "User X granted App Y these scopes"
/// @conditional(idp=oauth-server)
model OAuthAuthorization {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  clientId  String    @map("client_id")
  scopes    String[]
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@map("oauth_authorizations")
  @@schema("public")
}

// Issued access tokens (for introspection & revocation)
/// @conditional(idp=oauth-server)
model OAuthAccessToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  clientId  String    @map("client_id")
  userId    String    @map("user_id")
  scopes    String[]
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
  @@map("oauth_access_tokens")
  @@schema("public")
}

// ============================================
// Self-hosted Auth (Better Auth)
// ============================================
// These tables are only populated when using a self-hosted auth provider.
// When using Clerk, user data lives in Clerk's infrastructure.

/// @conditional(auth=betterauth)
model AuthUser {
  id                  String               @id @default(cuid())
  email               String?              @unique
  phone               String?              @unique
  emailVerified       Boolean              @default(false) @map("email_verified")
  phoneVerified       Boolean              @default(false) @map("phone_verified")
  name                String?
  image               String?
  passwordHash        String?              @map("password_hash")
  twoFactorEnabled    Boolean              @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?              @map("two_factor_secret")
  backupCodes         String[]             @default([]) @map("backup_codes")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  accounts            AuthAccount[]
  sessions            AuthSession[]
  desktopAuthHandoffs DesktopAuthHandoff[]
  desktopAuthSessions DesktopAuthSession[]
  // Wave 2 Phase 1.1 — back-relations to BA plugin tables in `auth.*` schema.
  // These exist purely to satisfy Prisma's bidirectional-relation requirement
  // and do not alter `public.auth_users` itself.
  baMembers           BAMember[]
  baPasskeys          BAPasskey[]
  chatSessions        ChatSession[]

  @@map("auth_users")
  @@schema("public")
}

// ── Chat Sessions ────────────────────────────────────────────────────────────
// Persistent AI chat history per (org, user). Messages are stored as JSONB to
// preserve the UIMessage[] shape from @ai-sdk/react verbatim — we don't need
// to query message content, only fetch whole sessions. `mode` records which
// command mode the session was opened in (chat | data | workflow | search).
model ChatSession {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  userId        String   @map("user_id")
  title         String   @default("New chat") @db.VarChar(200)
  mode          String   @default("chat") @db.VarChar(20)
  messages      Json     @default("[]")
  messageCount  Int      @default(0) @map("message_count")
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("chat_sessions")
  @@schema("public")
}

// ── Threads ──────────────────────────────────────────────────────────────────
// Clean-slate conversation thread model for the new Projects sidebar group.
// Intentionally not coupled to legacy ChatSession — Thread represents a
// long-running, summarisable workspace conversation rather than a single
// command-mode chat session.
model Thread {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  userId         String   @map("user_id")
  title          String   @default("Untitled") @db.VarChar(200)
  summary        String?  @db.Text
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, lastActivityAt(sort: Desc)])
  @@index([userId, lastActivityAt(sort: Desc)])
  @@map("threads")
  @@schema("public")
}

// ── User Profile / Personalization (TEMPLATE — schema ready) ─────────────────
// Memory-style personalization. Inject `customInstructions` into the chat
// system prompt to shape Sailor's behavior per user. `preferences` JSONB is
// the catch-all for communication toggles (productUpdates, taskAlerts, ads)
// so adding a new preference doesn't require a migration.
//
// One row per user (unique constraint on userId). Created lazily on first
// edit — we don't pre-create empty rows.
model UserProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  nickname           String?  @db.VarChar(80)
  occupation         String?  @db.VarChar(120)
  bio                String?
  customInstructions String?  @map("custom_instructions")
  preferences        Json     @default("{}")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_profiles")
  @@schema("public")
}

// ── Skills Marketplace (TEMPLATE — schema ready) ─────────────────────────────
// Modular agent capabilities. `Skill` is the catalogue entry (official or
// community); `UserSkill` is a user's installation + config + enabled state.
// Skill activation is checked when building the chat agent's tool list.
model Skill {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String
  category    String?  @db.VarChar(40)
  isOfficial  Boolean  @default(false) @map("is_official")
  version     String   @db.VarChar(20)
  tags        String[] @default([])
  iconUrl     String?  @map("icon_url")
  config      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  installations UserSkill[]

  @@index([isOfficial, category])
  @@map("skills")
  @@schema("public")
}

model UserSkill {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  tenantId    String?  @map("tenant_id")
  skillId     String   @map("skill_id")
  enabled     Boolean  @default(true)
  config      Json     @default("{}")
  installedAt DateTime @default(now()) @map("installed_at")

  skill  Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([userId, skillId])
  @@index([userId, enabled])
  @@map("user_skills")
  @@schema("public")
}

// ── Connectors (TEMPLATE — schema ready) ─────────────────────────────────────
// User-level external integrations: MCP servers, OAuth apps, custom APIs.
// `config` MUST be encrypted via @nebutra/vault before persistence — the
// model schema doesn't enforce this; the calling code does.
model Connector {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tenantId   String?   @map("tenant_id")
  type       String    @db.VarChar(40)
  name       String    @db.VarChar(120)
  iconUrl    String?   @map("icon_url")
  config     Json
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId, isActive, lastUsedAt(sort: Desc)])
  @@map("connectors")
  @@schema("public")
}

// ── Match Your Cofounder (opt-in cofounder matching) ─────────────────────────
// CofounderProfile = a tenant's OPT-IN entry into the cofounder pool. No row ⇒
// not in the pool (privacy: opt-OUT by default). One profile per tenant (OPC).
model CofounderProfile {
  id        String   @id @default(cuid())
  tenantId  String   @unique @map("tenant_id")
  userId    String   @map("user_id")
  archetype String?  @db.VarChar(40)
  arena     String   @db.VarChar(60)
  headline  String   @db.VarChar(280)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sentInterests     CofounderInterest[] @relation("CofounderInterestFrom")
  receivedInterests CofounderInterest[] @relation("CofounderInterestTo")

  @@index([isActive, arena])
  @@map("cofounder_profiles")
  @@schema("public")
}

// CofounderInterest = a directional signal between two pool profiles. Mutual
// INTERESTED (both directions) is a match. PASS hides; PITCH carries a note.
model CofounderInterest {
  id            String                @id @default(cuid())
  fromProfileId String                @map("from_profile_id")
  toProfileId   String                @map("to_profile_id")
  kind          CofounderInterestKind
  pitch         String?               @db.VarChar(1000)
  createdAt     DateTime              @default(now()) @map("created_at")

  fromProfile CofounderProfile @relation("CofounderInterestFrom", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfile   CofounderProfile @relation("CofounderInterestTo", fields: [toProfileId], references: [id], onDelete: Cascade)

  @@unique([fromProfileId, toProfileId])
  @@index([toProfileId, kind])
  @@map("cofounder_interests")
  @@schema("public")
}

enum CofounderInterestKind {
  PASS
  INTERESTED
  PITCH

  @@schema("public")
}

// ── Cold-start Access Gate (provider-agnostic) ───────────────────────────────
// Manus-style invite gate for controlled signup access. Deliberately stores
// only a hash/prefix of the secret code: plaintext is returned once by the
// service layer and never persisted. User/tenant ids are plain strings because
// this gate must work across Better Auth, NextAuth/Auth.js, Clerk, and future
// providers without hard FK coupling to one auth schema.
/// @conditional(access-gate=invite)
model AccessInviteCode {
  id              String             @id @default(cuid())
  codeHash        String             @unique @map("code_hash") @db.VarChar(128)
  codePrefix      String             @map("code_prefix") @db.VarChar(16)
  scope           AccessInviteScope  @default(PLATFORM)
  tenantId        String?            @map("tenant_id")
  issuedByUserId  String             @map("issued_by_user_id")
  issuedToEmail   String?            @map("issued_to_email") @db.VarChar(254)
  status          AccessInviteStatus @default(ACTIVE)
  maxRedemptions  Int                @default(1) @map("max_redemptions")
  redemptionCount Int                @default(0) @map("redemption_count")
  expiresAt       DateTime?          @map("expires_at")
  revokedAt       DateTime?          @map("revoked_at")
  metadata        Json               @default("{}")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  redemptions AccessInviteRedemption[]

  @@index([issuedByUserId, status, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([codePrefix])
  @@map("access_invite_codes")
  @@schema("public")
}

/// @conditional(access-gate=invite)
model AccessInviteRedemption {
  id           String   @id @default(cuid())
  inviteCodeId String   @map("invite_code_id")
  userId       String   @map("user_id")
  tenantId     String?  @map("tenant_id")
  email        String?  @db.VarChar(254)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  redeemedAt   DateTime @default(now()) @map("redeemed_at")
  metadata     Json     @default("{}")

  inviteCode AccessInviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)

  @@unique([inviteCodeId, userId])
  @@index([userId, redeemedAt(sort: Desc)])
  @@index([tenantId, redeemedAt(sort: Desc)])
  @@map("access_invite_redemptions")
  @@schema("public")
}

// ── Referrals (TEMPLATE — schema ready, no UI yet) ───────────────────────────
// Invite-to-earn loop. Single-source-of-truth for codes the referrer can
// share. `referredUserId` is null until claim; `referredEmail` is captured
// as a non-binding contact hint during invitation. Status transitions:
//   pending → claimed (on signup)
//   pending → expired (after expiresAt)
// Reward credits land in @nebutra/metering once metering grows a credits API
// — for now this is just provenance.
model Referral {
  id             String    @id @default(cuid())
  code           String    @unique @db.VarChar(20)
  referrerUserId String    @map("referrer_user_id")
  referredEmail  String?   @map("referred_email") @db.VarChar(254)
  referredUserId String?   @map("referred_user_id")
  status         String    @default("pending") @db.VarChar(20)
  rewardCredits  Int       @default(0) @map("reward_credits")
  level          Int       @default(0)
  expiresAt      DateTime? @map("expires_at")
  claimedAt      DateTime? @map("claimed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([referrerUserId, status, createdAt(sort: Desc)])
  @@index([referredUserId])
  @@map("referrals")
  @@schema("public")
}

// ── Redemption Codes (TEMPLATE — schema ready, no UI yet) ────────────────────
// Promotional / gift code system. Each `RedemptionCode` is a campaign-level
// definition; each `CodeRedemption` is a user's claim of it. The unique
// (codeId, userId) constraint enforces "one claim per user per code", even
// when maxRedemptions > 1 (i.e. the code is shareable but personal).
model RedemptionCode {
  id              String    @id @default(cuid())
  code            String    @unique @db.VarChar(40)
  type            String    @db.VarChar(20)
  rewardAmount    Int       @default(0) @map("reward_amount")
  rewardPayload   Json      @default("{}") @map("reward_payload")
  maxRedemptions  Int       @default(1) @map("max_redemptions")
  redemptionCount Int       @default(0) @map("redemption_count")
  expiresAt       DateTime? @map("expires_at")
  campaignName    String?   @map("campaign_name") @db.VarChar(80)
  createdAt       DateTime  @default(now()) @map("created_at")

  redemptions CodeRedemption[]

  @@index([campaignName, createdAt(sort: Desc)])
  @@map("redemption_codes")
  @@schema("public")
}

model CodeRedemption {
  id         String   @id @default(cuid())
  codeId     String   @map("code_id")
  userId     String   @map("user_id")
  tenantId   String?  @map("tenant_id")
  redeemedAt DateTime @default(now()) @map("redeemed_at")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)

  code   RedemptionCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  tenant Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([codeId, userId])
  @@index([userId, redeemedAt(sort: Desc)])
  @@map("code_redemptions")
  @@schema("public")
}

// ── Feedback Reports ─────────────────────────────────────────────────────────
// In-app issue / feedback submissions. Lightweight — no relations, soft-typed
// `area` and `mode` so adding new surfaces doesn't require a migration.
// `resolved` defaults to false so unread reports surface naturally in queries
// `ORDER BY resolved ASC, created_at DESC`.
model FeedbackReport {
  id           String    @id @default(cuid())
  tenantId     String?   @map("tenant_id")
  userId       String?   @map("user_id")
  area         String    @db.VarChar(40)
  mode         String?   @db.VarChar(20)
  description  String
  contactEmail String?   @map("contact_email") @db.VarChar(254)
  sessionId    String?   @map("session_id")
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  pageUrl      String?   @map("page_url") @db.VarChar(500)
  resolved     Boolean   @default(false)
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([resolved, createdAt(sort: Desc)])
  @@map("feedback_reports")
  @@schema("public")
}

/// @conditional(auth=betterauth)
model AuthAccount {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
  @@schema("public")
}

/// @conditional(auth=betterauth)
model AuthSession {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  token                String   @unique
  expiresAt            DateTime @map("expires_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  // Active organization id, populated by Better Auth's organization plugin
  // when the user calls `auth.api.setActiveOrganization()`. Read by the
  // tenant bridge middleware in Phase 2 to call `runWithTenant()`.
  activeOrganizationId String?  @map("active_organization_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  user                 AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([activeOrganizationId])
  @@map("auth_sessions")
  @@schema("public")
}

/// @conditional(auth=betterauth)
model DesktopAuthHandoff {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  userId     String    @map("user_id")
  scheme     String    @db.VarChar(40)
  state      String    @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at")

  user    AuthUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session DesktopAuthSession?

  @@index([userId, createdAt(sort: Desc)])
  @@index([scheme, state])
  @@index([expiresAt])
  @@map("desktop_auth_handoffs")
  @@schema("public")
}

/// @conditional(auth=betterauth)
model DesktopAuthSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  handoffId  String    @unique @map("handoff_id")
  userId     String    @map("user_id")
  scheme     String    @db.VarChar(40)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user    AuthUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  handoff DesktopAuthHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([scheme, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("desktop_auth_sessions")
  @@schema("public")
}

/// @conditional(auth=betterauth)
model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([identifier, value])
  @@map("auth_verifications")
  @@schema("public")
}

// ============================================
// License & Community
// ============================================

enum LicenseTier {
  INDIVIDUAL
  OPC
  STARTUP
  ENTERPRISE

  @@schema("public")
}

enum LicenseType {
  FREE
  COMMERCIAL

  @@schema("public")
}

model CommunityProfile {
  id     String @id @default(cuid())
  userId String @unique @map("user_id") // Clerk user ID

  // Professional context
  displayName String? @map("display_name")
  role        String // "solo_developer" | "founder" | "cto" | "developer" | "other"
  company     String?
  teamSize    String? @map("team_size") // "1" | "2-5" | "6-20" | "21-50" | "50+"
  industry    String?

  // What they're building
  useCase      String? @map("use_case") // "saas" | "ai_tool" | "marketplace" | "internal_tool" | "agency" | "other"
  buildingWhat String? @map("building_what") @db.Text // free-text description

  // Acquisition
  referralSource String? @map("referral_source") // "twitter" | "github" | "product_hunt" | "friend" | "search" | "other"

  // Community engagement
  showcaseUrl   String? @map("showcase_url")
  githubHandle  String? @map("github_handle")
  twitterHandle String? @map("twitter_handle")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("community_profiles")
  @@schema("public")
}

model License {
  id     String @id @default(cuid())
  userId String @map("user_id") // Clerk user ID

  tier       LicenseTier
  type       LicenseType
  licenseKey String      @unique @default(cuid()) @map("license_key")

  // Acceptance
  acceptedAt      DateTime @default(now()) @map("accepted_at")
  acceptedIp      String?  @map("accepted_ip")
  acceptedVersion String   @default("1.0") @map("accepted_version") // License version accepted

  // Stripe (for paid tiers)
  stripeCustomerId     String? @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")
  stripePriceId        String? @map("stripe_price_id")

  // Validity
  expiresAt DateTime? @map("expires_at") // null = perpetual (individual/OPC)
  isActive  Boolean   @default(true) @map("is_active")

  // Metadata
  projectName String? @map("project_name") // What project they're using it for
  projectUrl  String? @map("project_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sleptonsProfile SleptonsaMemberProfile?

  @@map("licenses")
  @@schema("public")
}

// ============================================
// Sleptons Community
// ============================================

model SleptonsaMemberProfile {
  id                  String                       @id @default(cuid())
  member_number       Int                          @unique @default(autoincrement())
  user_id             String                       @unique @map("user_id")
  license_id          String                       @unique @map("license_id")
  slug                String                       @unique
  display_name        String                       @map("display_name")
  bio                 String?                      @db.Text
  avatar_url          String?                      @map("avatar_url")
  product_name        String?                      @map("product_name")
  product_url         String?                      @map("product_url")
  product_tagline     String?                      @map("product_tagline")
  tech_stack          String[]                     @map("tech_stack")
  looking_for         String[]                     @map("looking_for")
  tier                SleptonsTier                 @default(V0)
  is_public           Boolean                      @default(true) @map("is_public")
  embedding           Unsupported("vector(1536)")?
  github_handle       String?                      @map("github_handle")
  github_data         Json?                        @map("github_data")
  github_refreshed_at DateTime?                    @map("github_refreshed_at")
  created_at          DateTime                     @default(now()) @map("created_at")
  updated_at          DateTime                     @updatedAt @map("updated_at")

  license   License              @relation(fields: [license_id], references: [id])
  products  SleptonsProduct[]
  following SleptonsConnection[] @relation("follower")
  followers SleptonsConnection[] @relation("following")

  @@index([tier, is_public])
  @@index([created_at])
  @@map("sleptons_member_profiles")
  @@schema("public")
}

model SleptonsProduct {
  id            String       @id @default(cuid())
  member_id     String       @map("member_id")
