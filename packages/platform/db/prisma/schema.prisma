  userAgent   String?  @map("user_agent")
  metadata    Json     @default("{}") // Store specific cookie names/categories
  consentedAt DateTime @default(now()) @map("consented_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  expiresAt   DateTime @map("expires_at") // Cookie consent expires (e.g., 1 year)

  @@unique([visitorId])
  @@index([userId])
  @@index([consentedAt])
  @@index([userId, expiresAt])
  @@map("cookie_consents")
  @@schema("public")
}

// Contact Form Submissions
