  is_featured   Boolean      @default(false) @map("is_featured")
  featured_at   DateTime?    @map("featured_at")
  featured_week String?      @map("featured_week")
  created_at    DateTime     @default(now()) @map("created_at")

  member  SleptonsaMemberProfile @relation(fields: [member_id], references: [id], onDelete: Cascade)
  upvotes SleptonsUpvote[]

  @@index([member_id])
  @@index([is_featured, featured_week])
  @@map("sleptons_products")
  @@schema("public")
}

model SleptonsUpvote {
  member_id  String   @map("member_id")
  product_id String   @map("product_id")
  created_at DateTime @default(now()) @map("created_at")

  product SleptonsProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([member_id, product_id])
  @@map("sleptons_upvotes")
  @@schema("public")
}

model SleptonsConnection {
  follower_id  String   @map("follower_id")
  following_id String   @map("following_id")
  created_at   DateTime @default(now()) @map("created_at")

  follower  SleptonsaMemberProfile @relation("follower", fields: [follower_id], references: [id], onDelete: Cascade)
  following SleptonsaMemberProfile @relation("following", fields: [following_id], references: [id], onDelete: Cascade)

  @@id([follower_id, following_id])
  @@map("sleptons_connections")
  @@schema("public")
}

// ============================================
// Better Auth — Plugin Tables (auth.* schema)
// ============================================
// Greenfield tables for Better Auth's organization + passkey plugins. Live in
// the dedicated `auth` Postgres schema (Wave 2 Phase 1.1, Shape B isolation).
// Existing core BA tables (auth_users / auth_sessions / auth_accounts /
// auth_verifications) intentionally stay in `public` per ADR D3.
//
// Naming: prefixed `BA` (Better Auth) on the Prisma side to disambiguate from
// the legacy Clerk-shaped `Organization` / `OrganizationMember` /
// `OrganizationInvitation` models in `public.*`. The DB-side names match the
// Better Auth plugin defaults (`organization`, `member`, `invitation`,
// `passkey`) so the BA Prisma adapter resolves them without remapping.

/// @conditional(auth=betterauth)
model BAOrganization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")

  members     BAMember[]
  invitations BAInvitation[]

  @@map("organization")
  @@schema("better_auth")
}

/// @conditional(auth=betterauth)
model BAMember {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String   @default("member")
  createdAt      DateTime @default(now()) @map("created_at")

  user         AuthUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization BAOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("member")
  @@schema("better_auth")
}

/// @conditional(auth=betterauth)
model BAInvitation {
  id             String    @id @default(cuid())
  email          String
  inviterId      String    @map("inviter_id")
  organizationId String    @map("organization_id")
  role           String?
  status         String    @default("pending")
  expiresAt      DateTime? @map("expires_at")
  // ADR-12 phase 1 — additive fields, nullable / defaulted during dual-write.
  // Phase 3 will tighten `token` to UNIQUE NOT NULL and `expiresAt` to NOT NULL.
  token          String?
  acceptedAt     DateTime? @map("accepted_at")
  declinedAt     DateTime? @map("declined_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization BAOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("invitation")
  @@schema("better_auth")
}

/// @conditional(auth=betterauth)
model BAPasskey {
  id           String   @id @default(cuid())
  name         String?
  publicKey    String   @map("public_key")
  userId       String   @map("user_id")
  credentialID String   @unique @map("credential_i_d")
  counter      Int
  deviceType   String   @map("device_type")
  backedUp     Boolean  @map("backed_up")
  transports   String?
  createdAt    DateTime @default(now()) @map("created_at")

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey")
  @@schema("better_auth")
}

// ============================================
// Atelier — agentic creative canvas
// ============================================

// One row per canvas. The scene (Excalidraw-subset elements + files) is a
// single JSON column — the source product's one-blob-per-canvas shape, but
// with a tenant_id + RLS instead of an implicit single user. The logical canvas
// id is unique *within* a tenant, not globally.
model AtelierCanvas {
  pk        String   @id @default(cuid())
  id        String
  tenantId  String   @map("tenant_id")
  name      String
  scene     Json     @default("{\"elements\":[],\"files\":[]}")
  thumbnail String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, updatedAt])
  @@map("atelier_canvas")
  @@schema("public")
}

// Durable, tenant-scoped rollout log for @nebutra/agent-runtime.
// Append-only event-sourced turn record; one row per RolloutLine. The
// (tenant_id, thread_id, seq) unique key is the system-of-record ordering
// guarantee (fail-loud — unlike the best-effort audit log).
model AgentRolloutLine {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  threadId  String   @map("thread_id")
  seq       Int
  at        DateTime @map("at")
  payload   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, threadId, seq])
  @@index([tenantId, threadId, seq])
  @@map("agent_rollout_lines")
  @@schema("public")
}

// ─── Pebble support intake ────────────────────────────────────────────────────
// Private support data submitted by anonymous desktop clients, so these tables
// are deliberately NOT tenant-scoped: there is no signed-in Nebutra tenant at
// submission time. Access is service-role only; nothing here is addressable by
// ticket id alone. Contract: pebble/docs/reference/infra-index.md.

enum PebbleDiagnosticStatus {
  // Token issued, bytes not yet received. Expires without ever storing an object.
  PENDING_UPLOAD
  STORED
  // Tombstone. Kept so a support agent can verify a deletion actually happened;
  // carries no object key and no payload.
  DELETED

  @@schema("public")
}

model PebbleDiagnosticTicket {
  id String @id @default(cuid())

  // Client-generated, one bundle per submission. Unique so a retried token
  // request rebinds to the same ticket instead of orphaning storage.
  bundleSubmissionId String @unique @map("bundle_submission_id") @db.VarChar(191)

  status PebbleDiagnosticStatus @default(PENDING_UPLOAD)

  // Byte count the token was issued for. The upload is rejected unless
  // Content-Length matches exactly, so a token cannot be replayed for a
  // larger body than it was minted for.
  declaredBytes Int  @map("declared_bytes")
  storedBytes   Int? @map("stored_bytes")

  bucket         String? @db.VarChar(191)
  objectKey      String? @map("object_key") @db.VarChar(255)
  checksumSha256 String? @map("checksum_sha256") @db.VarChar(64)

  appVersion String? @map("app_version") @db.VarChar(64)
  platform   String? @db.VarChar(32)

  // Retention horizon (baseline 30 days). The sweeper deletes the object and
  // tombstones the row; object lifecycle rules must not outlive this.
  expiresAt DateTime  @map("expires_at")
  storedAt  DateTime? @map("stored_at")
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, expiresAt])
  @@map("pebble_diagnostic_tickets")
  @@schema("public")
}

enum PebbleFeedbackKind {
  FEEDBACK
  // Legacy crash compatibility. New reviewed crashes go straight to Sentry;
  // this exists for one release cycle of older clients.
  CRASH

  @@schema("public")
}

model PebbleFeedback {
  id String @id @default(cuid())

  submissionId String             @unique @map("submission_id") @db.VarChar(191)
  kind         PebbleFeedbackKind @default(FEEDBACK)

  message      String  @db.Text
  // Optional and user-supplied. Private support data — never mirrored into
  // issue trackers, analytics, or access logs.
  contactEmail String? @map("contact_email") @db.VarChar(320)

  appVersion String? @map("app_version") @db.VarChar(64)
  platform   String? @db.VarChar(32)
  locale     String? @db.VarChar(35)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt(sort: Desc)])
  @@map("pebble_feedback")
  @@schema("public")
}

// ============================================
// Platform staff (ecosystem control plane)
// ============================================
// AUDIT(no-tenant): platform staff are Nebutra operators, not tenant members.
// This table is deliberately tenant-less and cross-tenant by definition — it
// is what authorizes the `admin.nebutra.com` control plane to read across every
// tenant. It must never be joined into a tenant-scoped ability check.
//
// Orthogonal to `Role` / `OrganizationMember`: tenant roles grant nothing here,
// and a staff role grants nothing inside a tenant. See
// docs/plans/2026-07-28-nebutra-admin-control-plane-design.md §6.

enum PlatformStaffRole {
  // Release + feature flags + staff grants.
  PLATFORM_OWNER
  // Supply, queues, tenant suspension.
  PLATFORM_OPERATOR
  // Customer support: tenant lookup, impersonation, invites.
  PLATFORM_SUPPORT
  // Dashboards only, no writes.
  PLATFORM_READONLY

  @@schema("public")
}

model PlatformStaff {
  userId String            @id @map("user_id")
  role   PlatformStaffRole

  // Grants are never hard-deleted — revocation is a tombstone so the audit
  // trail can still explain an action taken while the grant was live.
  grantedById String?   @map("granted_by_id")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")
  // Why this person has this role (ticket, rotation, on-call handover).
  note        String?   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role, revokedAt])
  @@map("platform_staff")
  @@schema("public")
}
