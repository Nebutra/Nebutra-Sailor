// ============================================
// Multi-Tenant Core
// ============================================

model Organization {
  id        String   @id @default(cuid())
  clerkId   String   @unique @map("clerk_id")
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  logo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members OrganizationMember[]
  tenant  Tenant?

  @@map("organizations")
  @@schema("public")
}

enum TenantKind {
  ORGANIZATION
  INDIVIDUAL

  @@schema("public")
}

/// Tenant lifecycle state (personal-to-workspace lifecycle). A founder starts in
/// `personal_draft` (Individual tenant), may become `personal_paid`, signals
/// `workspace_ready` when forming a team, and lands in `organization_owned` once
/// an Organization tenant takes over. See proposal 2026-06-03.
enum TenantLifecycleState {
  personal_draft
  personal_paid
  workspace_ready
  organization_owned

  @@schema("public")
}

/// What a transfer-journal row moves. First version supports whole-CompanyContext
/// and whole-project transfer plus license carry-over — never partial copies.
enum TenantTransferKind {
  company_context
  startup_project
  license

  @@schema("public")
}

enum TenantTransferStatus {
  pending
  applied
  failed

  @@schema("public")
}

/// Tenant supertype — the isolation boundary. An Organization or an individual
/// User is each represented by exactly one Tenant. For organization tenants,
/// `id` is set equal to the Organization id (id-reuse) at provisioning time, so
/// existing owning-id values stay valid as tenant ids. RLS scopes data rows via
/// `app.current_tenant_id` = Tenant.id. Owned-data back-relations are added as
/// the data models retarget their FK from Organization to Tenant.
model Tenant {
  id             String               @id @default(cuid())
  kind           TenantKind
  lifecycleState TenantLifecycleState @default(personal_draft) @map("lifecycle_state")
  organizationId String?              @unique @map("organization_id")
  userId         String?              @unique @map("user_id")
  createdAt      DateTime             @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Data back-relations (retargeted from Organization in Phase 2)
  apiKeys                  APIKey[]
  atelierCanvases          AtelierCanvas[]
  auditLogs                AuditLog[]
  chatSessions             ChatSession[]
  codeRedemptions          CodeRedemption[]
  connectors               Connector[]
  cofounderProfile         CofounderProfile?
  contents                 Content[]
  creditBalances           CreditBalance[]
  customerFeatureOverrides CustomerFeatureOverride[]
  customerPlanVersions     CustomerPlanVersion[]
  customerUsageLimits      CustomerUsageLimit[]
  feedbackReports          FeedbackReport[]
  integrations             Integration[]
  tenantProviderKeys       TenantProviderKey[]
  automations              Automation[]
  automationRuns           AutomationRun[]
  workflowDefinitions      WorkflowDefinition[]
  workflowRuns             WorkflowRun[]
  invoices                 Invoice[]
  oauthClients             OAuthClient[]
  orders                   Order[]
  payments                 Payment[]
  paymentMethods           PaymentMethod[]
  products                 Product[]
  requestLogs              RequestLog[]
  stripeCustomers          StripeCustomer[]
  subscriptions            Subscription[]
  tasks                    Task[]
  threads                  Thread[]
  uploads                  UploadRecord[]
  usageLedgerEntries       UsageLedgerEntry[]
  userConsents             UserConsent[]
  userSkills               UserSkill[]
  transferJournalsOut      TenantTransferJournal[]   @relation("TenantTransferFrom")
  transferJournalsIn       TenantTransferJournal[]   @relation("TenantTransferTo")

  @@map("tenants")
  @@schema("public")
}

/// Audit + execution journal for personal-to-workspace asset transfers. A
/// form-team request records `pending` rows BEFORE the destination org Tenant
/// exists (it is provisioned asynchronously via the Clerk webhook), keyed by the
/// known `toOrganizationId`. The provisioning worker fills `toTenantId`,
/// re-points the named asset, and marks the row `applied` (or `failed` with
/// `error`). No implicit copy — each row is an explicit ownership change.
model TenantTransferJournal {
  id                 String               @id @default(cuid())
  fromTenantId       String               @map("from_tenant_id")
  toTenantId         String?              @map("to_tenant_id")
  toOrganizationId   String               @map("to_organization_id")
  kind               TenantTransferKind
  subjectId          String?              @map("subject_id")
  status             TenantTransferStatus @default(pending)
  initiatedByUserId  String               @map("initiated_by_user_id")
  cofounderProfileId String?              @map("cofounder_profile_id")
  error              String?
  createdAt          DateTime             @default(now()) @map("created_at")
  appliedAt          DateTime?            @map("applied_at")

  fromTenant Tenant  @relation("TenantTransferFrom", fields: [fromTenantId], references: [id], onDelete: Cascade)
  toTenant   Tenant? @relation("TenantTransferTo", fields: [toTenantId], references: [id], onDelete: SetNull)

  @@index([toOrganizationId, status])
  @@index([fromTenantId])
  @@map("tenant_transfer_journals")
  @@schema("public")
}

// ── API Keys ──────────────────────────────────────────────────────────────────
// Keys are hashed on creation; the plaintext is shown once and never stored.
// Soft-deleted via revokedAt so audit log references remain meaningful.
model APIKey {
  id           String    @id @default(cuid())
  name         String    @db.VarChar(64)
  keyHash      String    @unique @map("key_hash")
  keyPrefix    String    @map("key_prefix") @db.VarChar(16)
  tenantId     String    @map("tenant_id")
  createdById  String?   @map("created_by_id")
  lastUsedAt   DateTime? @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  scopes       String[]  @default([]) @map("scopes")
  rateLimitRps Int       @default(10) @map("rate_limit_rps")
  expiresAt    DateTime? @map("expires_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyHash])
  @@index([tenantId, revokedAt])
  @@map("api_keys")
  @@schema("public")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique @map("clerk_id")
  email     String   @unique
  name      String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizations       OrganizationMember[]
  contents            Content[]
  orders              Order[]
  oauthAuthorizations OAuthAuthorization[]
  threads             Thread[]
  tenant              Tenant?
  platformStaff       PlatformStaff?

  @@map("users")
  @@schema("public")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
  @@schema("public")
}

// ── Organization Invitations ────────────────────────────────────────────────
// Pending → Accepted | Declined | Expired state machine for inviting users to
// join an organization. The `token` is a unique, opaque identifier emailed to
// the invitee and used as the URL slug for the accept page.
model OrganizationInvitation {
  id             String    @id @default(cuid())
  email          String
  organizationId String    @map("organization_id")
  role           String    @default("member")
  status         String    @default("pending") // pending | accepted | declined | expired
  inviterId      String    @map("inviter_id")
  token          String    @unique
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  declinedAt     DateTime? @map("declined_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@index([organizationId])
  @@map("organization_invitations")
  @@schema("public")
}

// ── Notification Center ─────────────────────────────────────────────────────
// Provider-agnostic notification inbox and user preference storage. The user
// and tenant identifiers intentionally stay as strings so Clerk, Better Auth,
// Auth.js, and service tokens can share the same durable notification layer.
model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tenantId  String   @default("") @map("tenant_id")
  type      String   @db.VarChar(120)
  title     String   @db.VarChar(200)
  body      String   @db.Text
  data      Json     @default("{}")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, tenantId, read, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("notifications")
  @@schema("public")
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  tenantId           String   @default("") @map("tenant_id")
  channel            String   @db.VarChar(20)
  enabled            Boolean  @default(true)
  disabledCategories String[] @default([]) @map("disabled_categories")
  frequency          String   @default("immediate") @db.VarChar(20)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([userId, tenantId, channel])
  @@index([tenantId, channel])
  @@map("notification_preferences")
  @@schema("public")
}

// ============================================
// Content
// ============================================

/// @conditional(template=blog|portfolio)
model Content {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  authorId    String        @map("author_id")
  title       String
  slug        String?
  body        String        @db.Text
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author       User                 @relation(fields: [authorId], references: [id])
  embeddings   ContentEmbedding[]
  translations ContentTranslation[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([authorId])
  @@index([status])
  @@index([tenantId, status])
  @@index([tenantId, publishedAt])
  @@map("contents")
  @@schema("public")
}

/// @conditional(template=blog|portfolio)
model ContentTranslation {
  id        String   @id @default(cuid())
  contentId String   @map("content_id")
  locale    String   @db.VarChar(10)
  title     String
  body      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, locale])
  @@map("content_translations")
  @@schema("public")
}

// ============================================
// Embeddings (pgvector)
// ============================================

/// @conditional(template=blog|portfolio)
model ContentEmbedding {
  id        String                      @id @default(cuid())
  contentId String                      @map("content_id")
  embedding Unsupported("vector(1536)")
  model     String                      @default("text-embedding-3-small")
  createdAt DateTime                    @default(now()) @map("created_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("content_embeddings")
  @@schema("public")
}

// ============================================
// E-Commerce
// ============================================

/// @conditional(template=ecommerce)
model Product {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  externalId  String?  @map("external_id")
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD") @db.VarChar(3)
  inventory   Int      @default(0)
  imageUrl    String?  @map("image_url")
  metadata    Json?    @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@map("products")
  @@schema("public")
}

/// @conditional(template=ecommerce)
model Order {
  id           String      @id @default(cuid())
  tenantId     String      @map("tenant_id")
  userId       String      @map("user_id")
  externalId   String?     @map("external_id")
  status       OrderStatus @default(PENDING)
  totalAmount  Decimal     @db.Decimal(10, 2)
  currency     String      @default("USD") @db.VarChar(3)
  shippingInfo Json?       @map("shipping_info")
  metadata     Json?       @default("{}")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id])
  items  OrderItem[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([tenantId, status])
  @@index([tenantId, userId])
  @@map("orders")
  @@schema("public")
}

/// @conditional(template=ecommerce)
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
  @@schema("public")
}

/// @conditional(template=ecommerce)
model Integration {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  type        IntegrationType
  name        String
  credentials Json            @default("{}") // Encrypt in app layer
  settings    Json            @default("{}")
  isActive    Boolean         @default(true) @map("is_active")
  lastSyncAt  DateTime?       @map("last_sync_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, name])
  @@map("integrations")
  @@schema("public")
}

// ── Tenant AI Provider Keys (BYOK) ──────────────────────────────────────────────
// Customer-owned AI provider API keys (OpenRouter-style "Bring Your Own Key").
// `credentials` (shape: { apiKey }) is encrypted at rest by the @nebutra/db client
// extension (vault envelope encryption, tenant-bound GCM AAD, kind
// "provider_key.credentials"). The AI gateway prefers a tenant key when present
// and falls back to the platform key unless `alwaysUse` is set for that provider.
model TenantProviderKey {
  id           String     @id @default(cuid())
  tenantId     String     @map("tenant_id")
  provider     AIProvider
  label        String     @default("")
  credentials  Json       @default("{}") // { apiKey } — encrypted in app layer
  isActive     Boolean    @default(true) @map("is_active")
  // "Always use this key": when true, never fall back to the platform key for
  // this provider (mirrors OpenRouter's per-key option).
  alwaysUse    Boolean    @default(false) @map("always_use")
  lastTestedAt DateTime?  @map("last_tested_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("tenant_provider_keys")
  @@schema("public")
}

// ── Agent Automations (Local Agent Automation, cloud-reconciled) ────────────────
// Recurring AI-agent tasks. `Automation` maps the Codex `automation.toml`
// definition; `AutomationRun` maps each append-only `memory.md` run record.
// Cloud reconciliation vs the local reference: `execution_environment`/`cwds[]`
// are dropped (no user-local FS); `scopeRef` is the single logical cloud context.

enum AutomationStatus {
  ACTIVE
  PAUSED
  DISABLED

  @@schema("public")
}

enum AutomationScheduleKind {
  CRON
  RRULE // reserved — 422-gated at the API until a recurrence util lands

  @@schema("public")
}

enum AutomationRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
  PARTIAL

  @@schema("public")
}

enum ReasoningEffort {
  LOW
  MEDIUM
  HIGH
  XHIGH

  @@schema("public")
}

model Automation {
  id              String                 @id @default(cuid())
  tenantId        String                 @map("tenant_id")
  name            String                 @db.VarChar(200)
  prompt          String                 @db.Text
  status          AutomationStatus       @default(ACTIVE)
  scheduleKind    AutomationScheduleKind @default(CRON) @map("schedule_kind")
  scheduleExpr    String                 @map("schedule_expr") @db.VarChar(256)
  timezone        String                 @default("UTC") @db.VarChar(64)
  model           String                 @default("flagship") @db.VarChar(128)
  reasoningEffort ReasoningEffort        @default(MEDIUM) @map("reasoning_effort")
  // Replaces the reference `cwds[]` — one logical cloud context (thread id /
  // project slug / free-form label), not an FS-path array.
  scopeRef        String?                @map("scope_ref") @db.VarChar(120)
  // Standing config note — the only definition-level memory field; evolves
  // independently of the append-only run log.
  knownIssues     String[]               @default([]) @map("known_issues")
  nextRunAt       DateTime?              @map("next_run_at")
  lastRunAt       DateTime?              @map("last_run_at")
  metadata        Json                   @default("{}")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AutomationRun[]

  @@unique([tenantId, name])
  @@index([tenantId, status, nextRunAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("automations")
  @@schema("public")
}

model AutomationRun {
  id             String              @id @default(cuid())
  tenantId       String              @map("tenant_id")
  automationId   String              @map("automation_id")
  status         AutomationRunStatus @default(RUNNING)
  // "${automationId}::${scheduledAt.toISOString()}" — blocks double-fire on retry.
  idempotencyKey String              @map("idempotency_key") @db.VarChar(191)
  // Fresh per run (== runId) → links to AgentRolloutLine(tenant, thread, seq).
  threadId       String              @map("thread_id")
  triggeredBy    String              @default("scheduler") @map("triggered_by") @db.VarChar(20)
  scheduledAt    DateTime?           @map("scheduled_at")
  startedAt      DateTime?           @map("started_at")
  finishedAt     DateTime?           @map("finished_at")
  // memory.md per-run fields. git*/changedFiles stay null until a git connector
  // is wired into the runtime ToolRegistry (deferred).
  summary        String?             @db.Text
  changedFiles   String[]            @default([]) @map("changed_files")
  blockers       String[]            @default([])
  verifications  Json                @default("[]") // [{ command, result }]
  gitBranch      String?             @map("git_branch") @db.VarChar(200)
  gitCommitHash  String?             @map("git_commit_hash") @db.VarChar(40)
  gitPushStatus  String?             @map("git_push_status") @db.VarChar(20)
  tokenUsage     Json                @default("{}") @map("token_usage")
  // Precomputed read-back context ({knownIssues,lastOutcome,recentSummaries[]}).
  memorySnapshot Json                @default("{}") @map("memory_snapshot")
  taskId         String?             @map("task_id") // soft FK to tasks.id (no relation)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, automationId, createdAt(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("automation_runs")
  @@schema("public")
}

// ── Agent Workflows (multi-agent orchestration runtime) ─────────────────────────
// A WorkflowDefinition holds a TENANT-AUTHORED orchestration script (untrusted JS,
// executed only inside a QuickJS WASM sandbox — never eval'd in our process).
// WorkflowRun is the append-only run record: status, captured observability
// events, the script's return value, and token usage.

enum WorkflowStatus {
  ACTIVE
  DISABLED

  @@schema("public")
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("public")
}

model WorkflowDefinition {
  id              String         @id @default(cuid())
  tenantId        String         @map("tenant_id")
  name            String         @db.VarChar(200)
  description     String?        @db.VarChar(500)
  // Tenant-authored orchestration JS. Runs ONLY inside the QuickJS sandbox.
  scriptSource    String         @map("script_source") @db.Text
  status          WorkflowStatus @default(ACTIVE)
  defaultModel    String         @default("flagship") @map("default_model") @db.VarChar(128)
  // Runtime caps (also a cost guardrail).
  maxConcurrency  Int            @default(16) @map("max_concurrency")
  maxAgentsPerRun Int            @default(1000) @map("max_agents_per_run")
  maxRetries      Int            @default(2) @map("max_retries")
  timeoutMs       Int            @default(60000) @map("timeout_ms")
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   WorkflowRun[]

  @@unique([tenantId, name])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("workflow_definitions")
  @@schema("public")
}

model WorkflowRun {
  id             String            @id @default(cuid())
  tenantId       String            @map("tenant_id")
  workflowId     String            @map("workflow_id")
  status         WorkflowRunStatus @default(QUEUED)
  idempotencyKey String            @map("idempotency_key") @db.VarChar(191)
  // Fresh per run → links AgentRolloutLine(tenant, thread, seq) for replay.
  threadId       String            @map("thread_id")
  triggeredBy    String            @default("api") @map("triggered_by") @db.VarChar(20)
  args           Json              @default("{}")
  // The script's return value (capped). null until SUCCEEDED.
  result         Json?
  // Captured observability events (phase/agent_*), size-capped.
  events         Json              @default("[]")
  error          String?           @db.Text
  // { agentCalls, maxConcurrency, ... }
  stats          Json              @default("{}")
  tokenUsage     Json              @default("{}") @map("token_usage")
  startedAt      DateTime?         @map("started_at")
  finishedAt     DateTime?         @map("finished_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, workflowId, createdAt(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("workflow_runs")
  @@schema("public")
}

