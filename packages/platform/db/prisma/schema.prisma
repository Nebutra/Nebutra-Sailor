// ============================================
// Billing & Monetization
// ============================================

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  TRIALING
  PAUSED
  INCOMPLETE

  @@schema("public")
}

enum BillingInterval {
  MONTHLY
  YEARLY
  WEEKLY
  ONE_TIME

  @@schema("public")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE

  @@schema("public")
}

enum PaymentMethodType {
  CARD
  BANK_TRANSFER
  ALIPAY
  WECHAT_PAY
  CRYPTO

  @@schema("public")
}

enum CreditTransactionType {
  PURCHASE
  USAGE
  REFUND
  ADJUSTMENT
  EXPIRATION
  BONUS

  @@schema("public")
}

enum UsageType {
  API_CALL
  AI_TOKEN
  STORAGE
  COMPUTE
  BANDWIDTH
  CUSTOM

  @@schema("public")
}

enum UsageLedgerSource {
  API
  WORKFLOW
  WEBHOOK
  SYSTEM
  BACKFILL

  @@schema("public")
}

// ============================================
// Dynamic Plan Configuration (Unicorn SaaS Pattern)
// ============================================

// Feature Definitions - All possible features in the system
model FeatureDefinition {
  id           String   @id @default(cuid())
  key          String   @unique @db.VarChar(100) // ai.chat, ai.embeddings, web3.nft
  name         String
  description  String?
  category     String   @db.VarChar(50) // ai, content, recsys, ecommerce, web3
  valueType    String   @default("boolean") @map("value_type") @db.VarChar(20) // boolean, number, unlimited
  defaultValue Json     @default("false") @map("default_value")
  metadata     Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  planFeatures PlanFeature[]

  @@index([category])
  @@map("feature_definitions")
  @@schema("public")
}

// Usage Limit Definitions - All possible usage metrics
model UsageLimitDefinition {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(50) // ai_tokens, api_calls, storage_bytes
  name        String
  description String?
  unit        String   @db.VarChar(20) // tokens, calls, bytes, minutes
  resetPeriod String   @default("monthly") @map("reset_period") @db.VarChar(20) // monthly, daily, never
  overageRate Decimal? @map("overage_rate") @db.Decimal(10, 8) // cost per unit over limit
  metadata    Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  planLimits     PlanUsageLimit[]
  customerLimits CustomerUsageLimit[]

  @@map("usage_limit_definitions")
  @@schema("public")
}

// Price/Plan Configuration (Versioned)
model PricingPlan {
  id          String          @id @default(cuid())
  stripeId    String?         @unique @map("stripe_id")
  name        String
  slug        String          @unique @db.VarChar(50) // free, pro, enterprise
  description String?
  plan        Plan // FREE, PRO, ENTERPRISE
  interval    BillingInterval @default(MONTHLY)
  amount      Decimal         @db.Decimal(10, 2)
  currency    String          @default("USD") @db.VarChar(3)
  trialDays   Int             @default(0) @map("trial_days")

  // Versioning for grandfathering
  version       String    @default("v1") @db.VarChar(20)
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  // Inheritance
  basePlanId   String?       @map("base_plan_id")
  basePlan     PricingPlan?  @relation("PlanInheritance", fields: [basePlanId], references: [id])
  derivedPlans PricingPlan[] @relation("PlanInheritance")

  // Status
  isActive Boolean @default(true) @map("is_active")
  isPublic Boolean @default(true) @map("is_public") // show on pricing page

  // Legacy JSON fields (for migration, prefer relations)
  features Json @default("[]") // Deprecated: use planFeatures
  limits   Json @default("{}") // Deprecated: use planLimits
  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  subscriptions     Subscription[]
  invoiceItems      InvoiceItem[]
  planFeatures      PlanFeature[]
  planLimits        PlanUsageLimit[]
  grandfatheredOrgs CustomerPlanVersion[]

  @@unique([slug, version])
  @@index([plan, isActive])
  @@map("pricing_plans")
  @@schema("public")
}

// Plan Features - Many-to-many with values
model PlanFeature {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  featureId String   @map("feature_id")
  value     Json // true, false, or specific value
  isEnabled Boolean  @default(true) @map("is_enabled")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  plan    PricingPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@map("plan_features")
  @@schema("public")
}

// Plan Usage Limits
model PlanUsageLimit {
  id          String   @id @default(cuid())
  planId      String   @map("plan_id")
  limitId     String   @map("limit_id")
  limitValue  BigInt   @map("limit_value") // -1 = unlimited
  overageRate Decimal? @map("overage_rate") @db.Decimal(10, 8) // override default
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  plan     PricingPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  limitDef UsageLimitDefinition @relation(fields: [limitId], references: [id], onDelete: Cascade)

  @@unique([planId, limitId])
  @@map("plan_usage_limits")
  @@schema("public")
}

// ============================================
// Customer Overrides (Grandfathering & Custom Deals)
// ============================================

// Customer-specific plan version lock (grandfathering)
model CustomerPlanVersion {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  planId         String    @map("plan_id")
  reason         String? // "Legacy customer", "Enterprise deal", "Beta tester"
  approvedBy     String?   @map("approved_by") // admin user id
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  plan PricingPlan @relation(fields: [planId], references: [id])

  @@unique([organizationId])
  @@map("customer_plan_versions")
  @@schema("public")
}

// Customer-specific feature overrides
model CustomerFeatureOverride {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  featureKey     String    @map("feature_key") @db.VarChar(100)
  value          Json // override value
  reason         String? // "Sales deal", "Support escalation"
  approvedBy     String?   @map("approved_by")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, featureKey])
  @@index([featureKey])
  @@map("customer_feature_overrides")
  @@schema("public")
}

// Customer-specific usage limit overrides
model CustomerUsageLimit {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  limitId        String    @map("limit_id")
  limitValue     BigInt    @map("limit_value") // -1 = unlimited
  overageRate    Decimal?  @map("overage_rate") @db.Decimal(10, 8)
  reason         String? // "Enterprise deal", "Promo"
  approvedBy     String?   @map("approved_by")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  limitDef UsageLimitDefinition @relation(fields: [limitId], references: [id])

  @@unique([organizationId, limitId])
  @@map("customer_usage_limits")
  @@schema("public")
}

// Subscription Management
model Subscription {
  id                 String             @id @default(cuid())
  stripeId           String?            @unique @map("stripe_id")
  organizationId     String             @map("organization_id")
  pricingPlanId      String             @map("pricing_plan_id")
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime?          @map("canceled_at")
  trialStart         DateTime?          @map("trial_start")
  trialEnd           DateTime?          @map("trial_end")
  metadata           Json               @default("{}")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  pricingPlan        PricingPlan        @relation(fields: [pricingPlanId], references: [id])
  invoices           Invoice[]
  usageLedgerEntries UsageLedgerEntry[]

  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
  @@map("subscriptions")
  @@schema("public")
}

// Invoice Management
/// @conditional(payment=wechat|alipay)
model Invoice {
  id               String        @id @default(cuid())
  stripeId         String?       @unique @map("stripe_id")
  organizationId   String        @map("organization_id")
  subscriptionId   String?       @map("subscription_id")
  number           String        @unique
  status           InvoiceStatus @default(DRAFT)
  subtotal         Decimal       @db.Decimal(10, 2)
  tax              Decimal       @default(0) @db.Decimal(10, 2)
  total            Decimal       @db.Decimal(10, 2)
  amountPaid       Decimal       @default(0) @map("amount_paid") @db.Decimal(10, 2)
  amountDue        Decimal       @map("amount_due") @db.Decimal(10, 2)
  currency         String        @default("USD") @db.VarChar(3)
  dueDate          DateTime?     @map("due_date")
  paidAt           DateTime?     @map("paid_at")
  invoicePdf       String?       @map("invoice_pdf")
  hostedInvoiceUrl String?       @map("hosted_invoice_url")
  billingReason    String?       @map("billing_reason") // subscription_create, subscription_cycle, manual
  metadata         Json          @default("{}")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]

  @@index([organizationId])
  @@index([status])
  @@index([dueDate])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("invoices")
  @@schema("public")
}

/// @conditional(payment=wechat|alipay)
model InvoiceItem {
  id            String   @id @default(cuid())
  invoiceId     String   @map("invoice_id")
  pricingPlanId String?  @map("pricing_plan_id")
  description   String
  quantity      Int      @default(1)
  unitAmount    Decimal  @map("unit_amount") @db.Decimal(10, 4)
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("USD") @db.VarChar(3)
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  pricingPlan PricingPlan? @relation(fields: [pricingPlanId], references: [id])

  @@map("invoice_items")
  @@schema("public")
}

// Payment Records
/// @conditional(payment=wechat|alipay)
model Payment {
  id                String            @id @default(cuid())
  stripeId          String?           @unique @map("stripe_id")
  organizationId    String            @map("organization_id")
  invoiceId         String?           @map("invoice_id")
  amount            Decimal           @db.Decimal(10, 2)
  currency          String            @default("USD") @db.VarChar(3)
  status            String            @db.VarChar(20) // succeeded, pending, failed
  paymentMethodType PaymentMethodType @map("payment_method_type")
  paymentMethodId   String?           @map("payment_method_id")
  failureCode       String?           @map("failure_code")
  failureMessage    String?           @map("failure_message")
  refundedAmount    Decimal           @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  metadata          Json              @default("{}")
  createdAt         DateTime          @default(now()) @map("created_at")

  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("payments")
  @@schema("public")
}

// Payment Methods
/// @conditional(payment=wechat|alipay)
model PaymentMethod {
  id             String            @id @default(cuid())
  stripeId       String?           @unique @map("stripe_id")
  organizationId String            @map("organization_id")
  type           PaymentMethodType
  isDefault      Boolean           @default(false) @map("is_default")
  lastFour       String?           @map("last_four") @db.VarChar(4)
  brand          String?           @db.VarChar(20) // visa, mastercard, etc.
  expiryMonth    Int?              @map("expiry_month")
  expiryYear     Int?              @map("expiry_year")
  billingDetails Json?             @map("billing_details") // name, address, email
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  payments Payment[]

  @@index([organizationId])
  @@map("payment_methods")
  @@schema("public")
}

// Usage Tracking (detailed)

// Immutable usage ledger (idempotent append-only records)
model UsageLedgerEntry {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  subscriptionId String?           @map("subscription_id")
  userId         String?           @map("user_id")
  idempotencyKey String            @map("idempotency_key") @db.VarChar(191)
  eventId        String?           @map("event_id") @db.VarChar(191)
  source         UsageLedgerSource @default(API)
  type           UsageType
  resource       String?           @db.VarChar(100)
  quantity       BigInt
  unit           String            @default("unit") @db.VarChar(32)
  unitCost       Decimal?          @map("unit_cost") @db.Decimal(10, 8)
  totalCost      Decimal?          @map("total_cost") @db.Decimal(10, 6)
  currency       String            @default("USD") @db.VarChar(3)
  occurredAt     DateTime          @map("occurred_at")
  recordedAt     DateTime          @default(now()) @map("recorded_at")
  ingestVersion  String            @default("v1") @map("ingest_version") @db.VarChar(16)
  metadata       Json              @default("{}")

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, occurredAt])
  @@index([organizationId, type, occurredAt])
  @@index([eventId])
  @@map("usage_ledger_entries")
  @@schema("public")
}

// Aggregated Usage (for billing)

// Credits System
/// @conditional(billing-mode=credits)
model CreditBalance {
  id             String   @id @default(cuid())
  organizationId String   @unique @map("organization_id")
  balance        Decimal  @default(0) @db.Decimal(10, 4)
  currency       String   @default("USD") @db.VarChar(3)
  updatedAt      DateTime @updatedAt @map("updated_at")

  transactions CreditTransaction[]

  @@map("credit_balances")
  @@schema("public")
}

/// @conditional(billing-mode=credits)
model CreditTransaction {
  id              String                @id @default(cuid())
  creditBalanceId String                @map("credit_balance_id")
  type            CreditTransactionType
  amount          Decimal               @db.Decimal(10, 4)
  balanceAfter    Decimal               @map("balance_after") @db.Decimal(10, 4)
  description     String?
  expiresAt       DateTime?             @map("expires_at")
  relatedId       String?               @map("related_id") // payment_id, usage_record_id, etc.
  metadata        Json                  @default("{}")
  createdAt       DateTime              @default(now()) @map("created_at")

  creditBalance CreditBalance @relation(fields: [creditBalanceId], references: [id], onDelete: Cascade)

  @@index([creditBalanceId])
  @@index([type])
  @@index([createdAt])
  @@map("credit_transactions")
  @@schema("public")
}

// Feature Entitlements

// Stripe Customer Mapping
model StripeCustomer {
  id             String   @id @default(cuid())
  organizationId String   @unique @map("organization_id")
  stripeId       String   @unique @map("stripe_id")
  email          String?
  name           String?
  currency       String   @default("USD") @db.VarChar(3)
  taxExempt      String   @default("none") @map("tax_exempt") @db.VarChar(20)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("stripe_customers")
  @@schema("public")
}

// Webhook Events (for idempotency)
model WebhookEvent {
  id           String    @id @default(cuid())
  provider     String    @db.VarChar(20) // stripe, paypal, etc.
  eventId      String    @map("event_id")
  eventType    String    @map("event_type")
  payload      Json
  processedAt  DateTime? @map("processed_at")
  errorMessage String?   @map("error_message")
  retryCount   Int       @default(0) @map("retry_count")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([eventType])
  @@index([processedAt])
  @@map("webhook_events")
  @@schema("public")
}

// ============================================
// Audit Logging
// ============================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  actorType      String?  @map("actor_type") @db.VarChar(20) // "user" | "system" | "api_key" | "admin"
  action         String   @db.VarChar(50)
  outcome        String?  @db.VarChar(10) // "success" | "failure" | "pending"
  reason         String?  @db.VarChar(255)
  entityType     String   @map("entity_type") @db.VarChar(50)
  entityId       String?  @map("entity_id")
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent")
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([outcome])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, userId])
  @@map("audit_logs")
  @@schema("public")
}

// ============================================
// Legal & Compliance
// ============================================

enum ConsentType {
  EXPLICIT // User explicitly clicked "I agree"
  IMPLICIT // Continued use implies consent
  OPT_IN // User opted in
  OPT_OUT // User opted out

  @@schema("public")
}

enum LegalDocumentType {
  PRIVACY_POLICY
  TERMS_OF_SERVICE
  COOKIE_POLICY
  REFUND_POLICY
  ACCEPTABLE_USE
  DATA_PROCESSING
  SLA
  CUSTOM

  @@schema("public")
}

// Legal Document Versions (tracked for compliance)
model LegalDocument {
  id          String            @id @default(cuid())
  slug        String            @db.VarChar(100) // privacy-policy, terms-of-service
  type        LegalDocumentType
  locale      String            @default("en") @db.VarChar(10)
  version     String            @db.VarChar(20) // v1.0.0 (semver)
  title       String
  summary     String? // Brief description of document
  contentHash String?           @map("content_hash") @db.VarChar(64) // SHA-256 of content
  effectiveAt DateTime          @map("effective_at")
  expiresAt   DateTime?         @map("expires_at")
  changelog   Json              @default("[]") // Array of changes
  metadata    Json              @default("{}")
  isActive    Boolean           @default(true) @map("is_active")
  isRequired  Boolean           @default(true) @map("is_required") // Must user consent?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  consents UserConsent[]

  @@unique([slug, version, locale])
  @@index([type, isActive])
  @@index([locale])
  @@index([slug, isActive, effectiveAt])
  @@index([locale, isActive, effectiveAt])
  @@map("legal_documents")
  @@schema("public")
}

// User Consent Records (audit trail for legal compliance)
model UserConsent {
  id              String      @id @default(cuid())
  userId          String?     @map("user_id") // Clerk user ID
  organizationId  String?     @map("organization_id") // Clerk org ID
  visitorId       String?     @map("visitor_id") // Anonymous visitor fingerprint
  documentId      String      @map("document_id")
  documentSlug    String      @map("document_slug") @db.VarChar(100)
  documentVersion String      @map("document_version") @db.VarChar(20)
  consentType     ConsentType @default(EXPLICIT) @map("consent_type")
  consentGiven    Boolean     @default(true) @map("consent_given")
  ipAddress       String?     @map("ip_address") @db.VarChar(45)
  userAgent       String?     @map("user_agent")
  consentContext  String?     @map("consent_context") @db.VarChar(100) // signup, checkout, settings
  metadata        Json        @default("{}")
  consentedAt     DateTime    @default(now()) @map("consented_at")
  withdrawnAt     DateTime?   @map("withdrawn_at") // If consent was withdrawn

  document LegalDocument @relation(fields: [documentId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([visitorId])
  @@index([documentSlug, documentVersion])
  @@index([consentedAt])
  @@index([documentSlug, consentGiven, withdrawnAt])
  @@map("user_consents")
  @@schema("public")
}

// Cookie Consent (GDPR/CCPA compliance)
model CookieConsent {
  id          String   @id @default(cuid())
  visitorId   String   @map("visitor_id") // Anonymous visitor fingerprint
  userId      String?  @map("user_id") // If logged in
  necessary   Boolean  @default(true) // Always required, cannot be disabled
  functional  Boolean  @default(false) // Preferences, language, etc.
  analytics   Boolean  @default(false) // Google Analytics, Mixpanel, etc.
  marketing   Boolean  @default(false) // Ads, retargeting, etc.
  thirdParty  Boolean  @default(false) @map("third_party") // Third-party embeds
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent")
  metadata    Json     @default("{}") // Store specific cookie names/categories
  consentedAt DateTime @default(now()) @map("consented_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  expiresAt   DateTime @map("expires_at") // Cookie consent expires (e.g., 1 year)

  @@unique([visitorId])
  @@index([userId])
  @@index([consentedAt])
  @@index([userId, expiresAt])
  @@map("cookie_consents")
  @@schema("public")
}

// Contact Form Submissions
model ContactSubmission {
  id          String    @id @default(cuid())
  name        String
  email       String
  company     String?
  phone       String?
  subject     String    @db.VarChar(200)
  message     String    @db.Text
  category    String    @default("general") @db.VarChar(50) // general, sales, support, legal, privacy
  status      String    @default("new") @db.VarChar(20) // new, in_progress, resolved, spam
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  userAgent   String?   @map("user_agent")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")

  @@index([email])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@map("contact_submissions")
  @@schema("public")
}

// ============================================
// OAuth 2.0 / OpenID Connect Identity Provider
// ============================================

enum OAuthClientType {
  CONFIDENTIAL // Server-side apps (have a secret)
  PUBLIC // SPAs, mobile apps, CLIs (no secret)

  @@schema("public")
}

enum OAuthClientStatus {
  ACTIVE
  SUSPENDED
  REVOKED

  @@schema("public")
}

// Third-party applications registered in Nebutra's ecosystem
model OAuthClient {
  id               String            @id @default(cuid())
  clientId         String            @unique @map("client_id")
  clientSecretHash String?           @map("client_secret_hash")
  type             OAuthClientType   @default(CONFIDENTIAL)
  status           OAuthClientStatus @default(ACTIVE)
  name             String
  description      String?           @db.Text
  logoUrl          String?           @map("logo_url")
  websiteUrl       String?           @map("website_url")
  privacyPolicyUrl String?           @map("privacy_policy_url")
  tosUrl           String?           @map("tos_url")

  // OAuth configuration
  redirectUris            String[] @map("redirect_uris")
  allowedScopes           String[] @default(["openid", "profile"]) @map("allowed_scopes")
  grantTypes              String[] @default(["authorization_code"]) @map("grant_types")
  responseTypes           String[] @default(["code"]) @map("response_types")
  tokenEndpointAuthMethod String   @default("client_secret_basic") @map("token_endpoint_auth_method")

  // Rate limiting & security
  rateLimitRpm    Int @default(60) @map("rate_limit_rpm")
  accessTokenTtl  Int @default(3600) @map("access_token_ttl")
  refreshTokenTtl Int @default(2592000) @map("refresh_token_ttl")

  // Ownership
  organizationId String  @map("organization_id")
  createdById    String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorizations OAuthAuthorization[]
  accessTokens   OAuthAccessToken[]

  @@index([organizationId])
  @@index([status])
  @@map("oauth_clients")
  @@schema("public")
}

// User consent records — "User X granted App Y these scopes"
/// @conditional(idp=oauth-server)
model OAuthAuthorization {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  clientId  String    @map("client_id")
  scopes    String[]
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@map("oauth_authorizations")
  @@schema("public")
}

// Issued access tokens (for introspection & revocation)
/// @conditional(idp=oauth-server)
model OAuthAccessToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  clientId  String    @map("client_id")
  userId    String    @map("user_id")
  scopes    String[]
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
  @@map("oauth_access_tokens")
  @@schema("public")
}

// ============================================
// Self-hosted Auth (Better Auth)
// ============================================
// These tables are only populated when using a self-hosted auth provider.
// When using Clerk, user data lives in Clerk's infrastructure.

/// @conditional(auth=betterauth)
model AuthUser {
  id               String        @id @default(cuid())
  email            String?       @unique
  phone            String?       @unique
  emailVerified    Boolean       @default(false) @map("email_verified")
  phoneVerified    Boolean       @default(false) @map("phone_verified")
  name             String?
  image            String?
  passwordHash     String?       @map("password_hash")
  twoFactorEnabled Boolean       @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?       @map("two_factor_secret")
  backupCodes      String[]      @default([]) @map("backup_codes")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  accounts         AuthAccount[]
  sessions         AuthSession[]
  // Wave 2 Phase 1.1 — back-relations to BA plugin tables in `auth.*` schema.
  // These exist purely to satisfy Prisma's bidirectional-relation requirement
  // and do not alter `public.auth_users` itself.
  baMembers        BAMember[]
  baPasskeys       BAPasskey[]
  chatSessions     ChatSession[]

  @@map("auth_users")
  @@schema("public")
}

// ── Chat Sessions ────────────────────────────────────────────────────────────
// Persistent AI chat history per (org, user). Messages are stored as JSONB to
// preserve the UIMessage[] shape from @ai-sdk/react verbatim — we don't need
// to query message content, only fetch whole sessions. `mode` records which
// command mode the session was opened in (chat | data | workflow | search).
model ChatSession {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  title          String   @default("New chat") @db.VarChar(200)
  mode           String   @default("chat") @db.VarChar(20)
  messages       Json     @default("[]")
  messageCount   Int      @default(0) @map("message_count")
  lastMessageAt  DateTime @default(now()) @map("last_message_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         AuthUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, lastMessageAt(sort: Desc)])
  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("chat_sessions")
  @@schema("public")
}

// ── User Profile / Personalization (TEMPLATE — schema ready) ─────────────────
// Memory-style personalization. Inject `customInstructions` into the chat
// system prompt to shape Sailor's behavior per user. `preferences` JSONB is
// the catch-all for communication toggles (productUpdates, taskAlerts, ads)
// so adding a new preference doesn't require a migration.
//
// One row per user (unique constraint on userId). Created lazily on first
// edit — we don't pre-create empty rows.
model UserProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  nickname           String?  @db.VarChar(80)
  occupation         String?  @db.VarChar(120)
  bio                String?
  customInstructions String?  @map("custom_instructions")
  preferences        Json     @default("{}")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_profiles")
  @@schema("public")
}

// ── Skills Marketplace (TEMPLATE — schema ready) ─────────────────────────────
// Modular agent capabilities. `Skill` is the catalogue entry (official or
// community); `UserSkill` is a user's installation + config + enabled state.
// Skill activation is checked when building the chat agent's tool list.
model Skill {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String
  category    String?  @db.VarChar(40)
  isOfficial  Boolean  @default(false) @map("is_official")
  version     String   @db.VarChar(20)
  tags        String[] @default([])
  iconUrl     String?  @map("icon_url")
  config      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  installations UserSkill[]

  @@index([isOfficial, category])
  @@map("skills")
  @@schema("public")
}

model UserSkill {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String?  @map("organization_id")
  skillId        String   @map("skill_id")
  enabled        Boolean  @default(true)
  config         Json     @default("{}")
  installedAt    DateTime @default(now()) @map("installed_at")

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId, enabled])
  @@map("user_skills")
  @@schema("public")
}

// ── Connectors (TEMPLATE — schema ready) ─────────────────────────────────────
// User-level external integrations: MCP servers, OAuth apps, custom APIs.
// `config` MUST be encrypted via @nebutra/vault before persistence — the
// model schema doesn't enforce this; the calling code does.
model Connector {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  organizationId String?   @map("organization_id")
  type           String    @db.VarChar(40)
  name           String    @db.VarChar(120)
  iconUrl        String?   @map("icon_url")
  config         Json
  isActive       Boolean   @default(true) @map("is_active")
  lastUsedAt     DateTime? @map("last_used_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId, isActive, lastUsedAt(sort: Desc)])
  @@map("connectors")
  @@schema("public")
}

// ── Referrals (TEMPLATE — schema ready, no UI yet) ───────────────────────────
// Invite-to-earn loop. Single-source-of-truth for codes the referrer can
// share. `referredUserId` is null until claim; `referredEmail` is captured
// as a non-binding contact hint during invitation. Status transitions:
//   pending → claimed (on signup)
//   pending → expired (after expiresAt)
// Reward credits land in @nebutra/metering once metering grows a credits API
// — for now this is just provenance.
model Referral {
  id             String    @id @default(cuid())
  code           String    @unique @db.VarChar(20)
  referrerUserId String    @map("referrer_user_id")
  referredEmail  String?   @map("referred_email") @db.VarChar(254)
  referredUserId String?   @map("referred_user_id")
  status         String    @default("pending") @db.VarChar(20)
  rewardCredits  Int       @default(0) @map("reward_credits")
  level          Int       @default(0)
  expiresAt      DateTime? @map("expires_at")
  claimedAt      DateTime? @map("claimed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([referrerUserId, status, createdAt(sort: Desc)])
  @@index([referredUserId])
  @@map("referrals")
  @@schema("public")
}

// ── Redemption Codes (TEMPLATE — schema ready, no UI yet) ────────────────────
// Promotional / gift code system. Each `RedemptionCode` is a campaign-level
// definition; each `CodeRedemption` is a user's claim of it. The unique
// (codeId, userId) constraint enforces "one claim per user per code", even
// when maxRedemptions > 1 (i.e. the code is shareable but personal).
model RedemptionCode {
  id              String    @id @default(cuid())
  code            String    @unique @db.VarChar(40)
  type            String    @db.VarChar(20)
  rewardAmount    Int       @default(0) @map("reward_amount")
  rewardPayload   Json      @default("{}") @map("reward_payload")
  maxRedemptions  Int       @default(1) @map("max_redemptions")
  redemptionCount Int       @default(0) @map("redemption_count")
  expiresAt       DateTime? @map("expires_at")
  campaignName    String?   @map("campaign_name") @db.VarChar(80)
  createdAt       DateTime  @default(now()) @map("created_at")

  redemptions CodeRedemption[]

  @@index([campaignName, createdAt(sort: Desc)])
  @@map("redemption_codes")
  @@schema("public")
}

model CodeRedemption {
  id             String   @id @default(cuid())
  codeId         String   @map("code_id")
  userId         String   @map("user_id")
  organizationId String?  @map("organization_id")
  redeemedAt     DateTime @default(now()) @map("redeemed_at")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)

  code RedemptionCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@unique([codeId, userId])
  @@index([userId, redeemedAt(sort: Desc)])
  @@map("code_redemptions")
  @@schema("public")
}

// ── Feedback Reports ─────────────────────────────────────────────────────────
// In-app issue / feedback submissions. Lightweight — no relations, soft-typed
// `area` and `mode` so adding new surfaces doesn't require a migration.
// `resolved` defaults to false so unread reports surface naturally in queries
// `ORDER BY resolved ASC, created_at DESC`.
model FeedbackReport {
  id             String    @id @default(cuid())
  organizationId String?   @map("organization_id")
  userId         String?   @map("user_id")
  area           String    @db.VarChar(40)
  mode           String?   @db.VarChar(20)
  description    String
  contactEmail   String?   @map("contact_email") @db.VarChar(254)
  sessionId      String?   @map("session_id")
  userAgent      String?   @map("user_agent") @db.VarChar(500)
  pageUrl        String?   @map("page_url") @db.VarChar(500)
  resolved       Boolean   @default(false)
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([resolved, createdAt(sort: Desc)])
  @@map("feedback_reports")
  @@schema("public")
}

/// @conditional(auth=betterauth)
model AuthAccount {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
  @@schema("public")
}

/// @conditional(auth=betterauth)
model AuthSession {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  token                 String   @unique
  expiresAt             DateTime @map("expires_at")
  ipAddress             String?  @map("ip_address")
  userAgent             String?  @map("user_agent")
  // Active organization id, populated by Better Auth's organization plugin
  // when the user calls `auth.api.setActiveOrganization()`. Read by the
  // tenant bridge middleware in Phase 2 to call `runWithTenant()`.
  activeOrganizationId  String?  @map("active_organization_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([activeOrganizationId])
  @@map("auth_sessions")
  @@schema("public")
}

/// @conditional(auth=betterauth)
model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([identifier, value])
  @@map("auth_verifications")
  @@schema("public")
}

// ============================================
// License & Community
// ============================================

enum LicenseTier {
  INDIVIDUAL
  OPC
  STARTUP
  ENTERPRISE

  @@schema("public")
}

enum LicenseType {
  FREE
  COMMERCIAL

  @@schema("public")
}

model CommunityProfile {
  id     String @id @default(cuid())
  userId String @unique @map("user_id") // Clerk user ID

  // Professional context
  displayName String? @map("display_name")
  role        String // "solo_developer" | "founder" | "cto" | "developer" | "other"
  company     String?
  teamSize    String? @map("team_size") // "1" | "2-5" | "6-20" | "21-50" | "50+"
  industry    String?

  // What they're building
  useCase      String? @map("use_case") // "saas" | "ai_tool" | "marketplace" | "internal_tool" | "agency" | "other"
  buildingWhat String? @map("building_what") @db.Text // free-text description

  // Acquisition
  referralSource String? @map("referral_source") // "twitter" | "github" | "product_hunt" | "friend" | "search" | "other"

  // Community engagement
  showcaseUrl   String? @map("showcase_url")
  githubHandle  String? @map("github_handle")
  twitterHandle String? @map("twitter_handle")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("community_profiles")
  @@schema("public")
}

model License {
  id     String @id @default(cuid())
  userId String @map("user_id") // Clerk user ID

  tier       LicenseTier
  type       LicenseType
  licenseKey String      @unique @default(cuid()) @map("license_key")

  // Acceptance
  acceptedAt      DateTime @default(now()) @map("accepted_at")
  acceptedIp      String?  @map("accepted_ip")
  acceptedVersion String   @default("1.0") @map("accepted_version") // License version accepted

  // Stripe (for paid tiers)
  stripeCustomerId     String? @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")
  stripePriceId        String? @map("stripe_price_id")

  // Validity
  expiresAt DateTime? @map("expires_at") // null = perpetual (individual/OPC)
  isActive  Boolean   @default(true) @map("is_active")

  // Metadata
  projectName String? @map("project_name") // What project they're using it for
  projectUrl  String? @map("project_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sleptonsProfile SleptonsaMemberProfile?

  @@map("licenses")
  @@schema("public")
}

// ============================================
// Sleptons Community
// ============================================

model SleptonsaMemberProfile {
  id                  String                       @id @default(cuid())
  member_number       Int                          @unique @default(autoincrement())
  user_id             String                       @unique @map("user_id")
  license_id          String                       @unique @map("license_id")
  slug                String                       @unique
  display_name        String                       @map("display_name")
  bio                 String?                      @db.Text
  avatar_url          String?                      @map("avatar_url")
  product_name        String?                      @map("product_name")
  product_url         String?                      @map("product_url")
  product_tagline     String?                      @map("product_tagline")
  tech_stack          String[]                     @map("tech_stack")
  looking_for         String[]                     @map("looking_for")
  tier                SleptonsTier                 @default(V0)
  is_public           Boolean                      @default(true) @map("is_public")
  embedding           Unsupported("vector(1536)")?
  github_handle       String?                      @map("github_handle")
  github_data         Json?                        @map("github_data")
  github_refreshed_at DateTime?                    @map("github_refreshed_at")
  created_at          DateTime                     @default(now()) @map("created_at")
  updated_at          DateTime                     @updatedAt @map("updated_at")

  license   License              @relation(fields: [license_id], references: [id])
  products  SleptonsProduct[]
  following SleptonsConnection[] @relation("follower")
  followers SleptonsConnection[] @relation("following")

  @@index([tier, is_public])
  @@index([created_at])
  @@map("sleptons_member_profiles")
  @@schema("public")
}

model SleptonsProduct {
  id            String       @id @default(cuid())
  member_id     String       @map("member_id")
  name          String
  tagline       String
  description   String?      @db.Text
  url           String?
  github_url    String?      @map("github_url")
  thumbnail_url String?      @map("thumbnail_url")
  stage         ProductStage @default(BUILDING)
  is_featured   Boolean      @default(false) @map("is_featured")
  featured_at   DateTime?    @map("featured_at")
  featured_week String?      @map("featured_week")
  created_at    DateTime     @default(now()) @map("created_at")

  member  SleptonsaMemberProfile @relation(fields: [member_id], references: [id], onDelete: Cascade)
  upvotes SleptonsUpvote[]

  @@index([member_id])
  @@index([is_featured, featured_week])
  @@map("sleptons_products")
  @@schema("public")
}

model SleptonsUpvote {
  member_id  String   @map("member_id")
  product_id String   @map("product_id")
  created_at DateTime @default(now()) @map("created_at")

  product SleptonsProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([member_id, product_id])
  @@map("sleptons_upvotes")
  @@schema("public")
}

model SleptonsConnection {
  follower_id  String   @map("follower_id")
  following_id String   @map("following_id")
  created_at   DateTime @default(now()) @map("created_at")

  follower  SleptonsaMemberProfile @relation("follower", fields: [follower_id], references: [id], onDelete: Cascade)
  following SleptonsaMemberProfile @relation("following", fields: [following_id], references: [id], onDelete: Cascade)

  @@id([follower_id, following_id])
  @@map("sleptons_connections")
  @@schema("public")
}

// ============================================
// Better Auth — Plugin Tables (auth.* schema)
// ============================================
// Greenfield tables for Better Auth's organization + passkey plugins. Live in
// the dedicated `auth` Postgres schema (Wave 2 Phase 1.1, Shape B isolation).
// Existing core BA tables (auth_users / auth_sessions / auth_accounts /
// auth_verifications) intentionally stay in `public` per ADR D3.
//
// Naming: prefixed `BA` (Better Auth) on the Prisma side to disambiguate from
// the legacy Clerk-shaped `Organization` / `OrganizationMember` /
// `OrganizationInvitation` models in `public.*`. The DB-side names match the
// Better Auth plugin defaults (`organization`, `member`, `invitation`,
// `passkey`) so the BA Prisma adapter resolves them without remapping.

/// @conditional(auth=betterauth)
model BAOrganization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")

  members     BAMember[]
  invitations BAInvitation[]

  @@map("organization")
  @@schema("auth")
}

/// @conditional(auth=betterauth)
model BAMember {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String   @default("member")
  createdAt      DateTime @default(now()) @map("created_at")

  user         AuthUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization BAOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("member")
  @@schema("auth")
}

/// @conditional(auth=betterauth)
model BAInvitation {
  id             String    @id @default(cuid())
  email          String
  inviterId      String    @map("inviter_id")
  organizationId String    @map("organization_id")
  role           String?
  status         String    @default("pending")
  expiresAt      DateTime? @map("expires_at")
  // ADR-12 phase 1 — additive fields, nullable / defaulted during dual-write.
  // Phase 3 will tighten `token` to UNIQUE NOT NULL and `expiresAt` to NOT NULL.
  token          String?
  acceptedAt     DateTime? @map("accepted_at")
  declinedAt     DateTime? @map("declined_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization BAOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("invitation")
  @@schema("auth")
}

/// @conditional(auth=betterauth)
model BAPasskey {
  id           String   @id @default(cuid())
  name         String?
  publicKey    String   @map("public_key")
  userId       String   @map("user_id")
  credentialID String   @unique @map("credential_i_d")
  counter      Int
  deviceType   String   @map("device_type")
  backedUp     Boolean  @map("backed_up")
  transports   String?
  createdAt    DateTime @default(now()) @map("created_at")

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey")
  @@schema("auth")
}
