// ============================================

enum AIProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  SILICONFLOW
  CUSTOM

  @@schema("public")
}

model ModelConfig {
  id                    String     @id @default(cuid())
  modelName             String     @unique @map("model_name") @db.VarChar(128)
  provider              AIProvider
  inputPricePerMillion  Decimal    @map("input_price_per_million") @db.Decimal(10, 6)
  outputPricePerMillion Decimal    @map("output_price_per_million") @db.Decimal(10, 6)
  currency              String     @default("USD") @db.VarChar(3)
  isActive              Boolean    @default(true) @map("is_active")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  @@map("model_configs")
  @@schema("public")
}

model RequestLog {
  id               String   @id @default(cuid())
  requestId        String   @unique @map("request_id")
  apiKeyId         String?  @map("api_key_id")
  organizationId   String   @map("organization_id")
  model            String   @db.VarChar(128)
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  cost             Decimal? @db.Decimal(10, 6)
  latencyMs        Int?     @map("latency_ms")
  status           String   @db.VarChar(16)
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([apiKeyId])
  @@index([model, createdAt])
  @@map("ai_request_logs")
  @@schema("public")
}

