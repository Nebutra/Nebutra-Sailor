{
  "name": "@nebutra/db",
  "version": "0.1.2",
  "private": true,
  "nebutra": {
    "status": "foundation",
    "graph": "core",
    "productionReady": false
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./pool": {
      "types": "./dist/pool.d.ts",
      "import": "./dist/pool.js",
      "default": "./dist/pool.js"
    },
    "./rls": {
      "types": "./dist/rls.d.ts",
      "import": "./dist/rls.js",
      "default": "./dist/rls.js"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "seed:models": "tsx scripts/seed-model-configs.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && cp src/generated/prisma-workerd/internal/query_compiler_fast_bg.js src/generated/prisma-workerd/internal/query_compiler_fast_bg.wasm dist/generated/prisma-workerd/internal/"
  },
  "dependencies": {
    "@nebutra/logger": "workspace:*",
    "@nebutra/tenant": "workspace:*",
    "@nebutra/vault": "workspace:*",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "catalog:",
    "@prisma/client-runtime-utils": "^7.4.2",
    "p-limit": "^7.3.0",
    "pg": "^8.20.0",
    "tokenlens": "^1.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@types/pg": "^8.18.0",
    "prisma": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "AGPL-3.0-only",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "imports": {
    "#prisma-client": {
      "workerd": "./dist/generated/prisma-workerd/client.js",
      "default": "./dist/generated/prisma/client.js"
    }
  }
}
