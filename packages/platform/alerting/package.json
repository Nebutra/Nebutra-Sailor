{
  "name": "@nebutra/alerting",
  "version": "0.1.0",
  "private": true,
  "nebutra": {
    "status": "foundation",
    "graph": "core",
    "productionReady": false
  },
  "description": "Alerting and notification utilities for Nebutra services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "p-limit": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "catalog:",
    "vitest": "^4.0.18"
  },
  "license": "AGPL-3.0-only"
}
