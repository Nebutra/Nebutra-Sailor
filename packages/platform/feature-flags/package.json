{
  "name": "@nebutra/feature-flags",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Feature flags abstraction - swap providers later",
  "nebutra": {
    "status": "foundation",
    "productionReady": true,
    "requires": [
      "@nebutra/cache",
      "or FEATURE_FLAG_* environment variables"
    ],
    "gaps": [
      "Managed providers not wired to real Vercel Flags/GrowthBook/ConfigCat SDK clients",
      "No rollout dashboard or persisted rule authoring UI"
    ]
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@nebutra/cache": "workspace:*",
    "@nebutra/db": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@types/node": "^22.19.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "license": "AGPL-3.0-only"
}
