{
  "name": "@nebutra/ai-providers",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-provider AI SDK for Nebutra - SiliconFlow, OpenAI, and more",
  "sideEffects": false,
  "type": "module",
  "nebutra": {
    "status": "wip",
    "productionReady": false,
    "requires": ["Provider API key (OPENAI_API_KEY, SILICONFLOW_API_KEY, OPENROUTER_API_KEY, etc.)"],
    "gaps": [
      "No production app integrations",
      "Provider implementations scaffolded but not exercised",
      "Unified retry/fallback strategy pending"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./meta": {
      "types": "./dist/meta.d.ts",
      "import": "./dist/meta.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./templates/*": "./templates/*"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "openai": "^6.27.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
