{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Community theme — Crimson primary, low-saturation chroma, light surface",
  "theme": "crimson-light-muted-3",
  "color": {
    "primary": {
      "$value": "#292524",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.950 0.001 85.5)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "accent": {
      "$value": "#16a34a",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "background": {
      "$value": "#f5f5f5",
      "$type": "color"
    },
    "foreground": {
      "$value": "#292524",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.978 0.000 88.8)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#292524",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.969 0.000 87.7)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#292524",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.960 0.000 86.6)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.690 0.005 54.1)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.941 0.001 84.4)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.950 0.001 85.5)",
      "$type": "color"
    },
    "ring": {
      "$value": "#292524",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #292524, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #292524, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #292524 0%, #16a34a 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "0.25rem",
      "$type": "dimension"
    },
    "md": {
      "$value": "0.375rem",
      "$type": "dimension"
    },
    "lg": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "xl": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(41 37 36 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(41 37 36 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(41 37 36 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(41 37 36 / 0.12)",
      "$type": "shadow"
    }
  }
}
