{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Pale silver-white on black — cool night, lunar glow",
  "theme": "cyan-dark-muted",
  "color": {
    "primary": {
      "$value": "#fcfdff",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.199 0.000 340.9)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "accent": {
      "$value": "#000033b3",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "background": {
      "$value": "#000000",
      "$type": "color"
    },
    "foreground": {
      "$value": "#fcfdff",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.060 0.000 354.3)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#fcfdff",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.080 0.000 352.4)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#fcfdff",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.120 0.000 348.5)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.648 0.001 297.9)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.219 0.000 339.0)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.179 0.000 342.8)",
      "$type": "color"
    },
    "ring": {
      "$value": "#fcfdff",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #fcfdff, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #fcfdff, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #fcfdff 0%, #000033b3 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "6px",
      "$type": "dimension"
    },
    "md": {
      "$value": "8px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "12px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "16px",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(252 253 255 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(252 253 255 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(252 253 255 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(252 253 255 / 0.12)",
      "$type": "shadow"
    }
  }
}
