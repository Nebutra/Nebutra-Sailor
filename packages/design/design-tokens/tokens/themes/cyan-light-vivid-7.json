{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Deep sky blue on white — expansive, clear, optimistic",
  "theme": "cyan-light-vivid-7",
  "color": {
    "primary": {
      "$value": "#0064e0",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.959 0.001 103.3)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "accent": {
      "$value": "#0457cb",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "background": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "foreground": {
      "$value": "#1c1e21",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.990 0.000 93.2)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#1c1e21",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.980 0.000 96.6)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#1c1e21",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.969 0.000 99.9)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.668 0.005 198.6)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.949 0.001 106.6)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.959 0.001 103.3)",
      "$type": "color"
    },
    "ring": {
      "$value": "#0064e0",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #0064e0, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #0064e0, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #0064e0 0%, #0457cb 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "4px",
      "$type": "dimension"
    },
    "md": {
      "$value": "6px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "8px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "16px",
      "$type": "dimension"
    },
    "full": {
      "$value": "100px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(0 100 224 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(0 100 224 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(0 100 224 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(0 100 224 / 0.12)",
      "$type": "shadow"
    }
  }
}
