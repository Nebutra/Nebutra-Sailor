{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Pure signal red on white — urgent, direct, unmissable",
  "theme": "crimson-light-vivid-3",
  "color": {
    "primary": {
      "$value": "#e60023",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.920 0.000 82.7)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "accent": {
      "$value": "#cc001f",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "background": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "foreground": {
      "$value": "#000000",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.980 0.000 88.1)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#000000",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.960 0.000 86.3)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#000000",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.940 0.000 84.5)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.350 0.000 31.5)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.900 0.000 80.9)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.920 0.000 82.7)",
      "$type": "color"
    },
    "ring": {
      "$value": "#e60023",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #e60023, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #e60023, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #e60023 0%, #cc001f 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "8px",
      "$type": "dimension"
    },
    "md": {
      "$value": "16px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "32px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(230 0 35 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(230 0 35 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(230 0 35 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(230 0 35 / 0.12)",
      "$type": "shadow"
    }
  }
}
