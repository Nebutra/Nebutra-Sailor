{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Community theme — Rose primary, vivid chroma, light surface",
  "theme": "rose-light-vivid-5",
  "color": {
    "primary": {
      "$value": "#ff4f00",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.955 0.004 85.6)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "accent": {
      "$value": "#ff4f00",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "background": {
      "$value": "#fffefb",
      "$type": "color"
    },
    "foreground": {
      "$value": "#201515",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.988 0.002 90.0)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#201515",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.977 0.003 88.6)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#201515",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.966 0.003 87.1)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.645 0.016 43.8)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.945 0.004 84.2)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.955 0.004 85.6)",
      "$type": "color"
    },
    "ring": {
      "$value": "#ff4f00",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #ff4f00, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #ff4f00, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #ff4f00 0%, #ff4f00 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "6px",
      "$type": "dimension"
    },
    "md": {
      "$value": "12px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "xl": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(255 79 0 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(255 79 0 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(255 79 0 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(255 79 0 / 0.12)",
      "$type": "shadow"
    }
  }
}
