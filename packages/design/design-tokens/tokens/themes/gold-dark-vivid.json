{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Neon yellow-gold on near-black — maximum energy, studio glow",
  "theme": "gold-dark-vivid",
  "color": {
    "primary": {
      "$value": "#faff69",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.472 0.000 89.9)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "accent": {
      "$value": "#e6eb52",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "background": {
      "$value": "#0a0a0a",
      "$type": "color"
    },
    "foreground": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.380 0.000 89.9)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.393 0.000 89.9)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.419 0.000 89.9)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.769 0.000 89.9)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.485 0.000 89.9)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.459 0.000 89.9)",
      "$type": "color"
    },
    "ring": {
      "$value": "#faff69",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #faff69, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #faff69, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #faff69 0%, #e6eb52 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "6px",
      "$type": "dimension"
    },
    "md": {
      "$value": "8px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "12px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(250 255 105 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(250 255 105 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(250 255 105 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(250 255 105 / 0.12)",
      "$type": "shadow"
    }
  }
}
