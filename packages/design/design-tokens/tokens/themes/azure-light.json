{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Midnight indigo on white — considered, literary, precise",
  "theme": "azure-light",
  "color": {
    "primary": {
      "$value": "#1b1938",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.963 0.000 88.2)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "accent": {
      "$value": "#c9b4fa",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "background": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "foreground": {
      "$value": "#292827",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.991 0.000 89.5)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#292827",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.982 0.000 89.0)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#292827",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.972 0.000 88.6)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.701 0.002 75.8)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.954 0.000 87.7)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.963 0.000 88.2)",
      "$type": "color"
    },
    "ring": {
      "$value": "#1b1938",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #1b1938, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #1b1938, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #1b1938 0%, #c9b4fa 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "6px",
      "$type": "dimension"
    },
    "md": {
      "$value": "8px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "12px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "16px",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(27 25 56 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(27 25 56 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(27 25 56 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(27 25 56 / 0.12)",
      "$type": "shadow"
    }
  }
}
