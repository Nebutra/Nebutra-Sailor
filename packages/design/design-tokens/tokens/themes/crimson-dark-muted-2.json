{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Community theme — Crimson primary, low-saturation chroma, dark surface",
  "theme": "crimson-dark-muted-2",
  "color": {
    "primary": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.200 0.000 18.0)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "accent": {
      "$value": "#c3d9f3",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "background": {
      "$value": "#000000",
      "$type": "color"
    },
    "foreground": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.060 0.000 5.4)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.080 0.000 7.2)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.120 0.000 10.8)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.650 0.000 58.4)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.220 0.000 19.8)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.180 0.000 16.2)",
      "$type": "color"
    },
    "ring": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #ffffff, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #ffffff, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #ffffff 0%, #c3d9f3 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "0.25rem",
      "$type": "dimension"
    },
    "md": {
      "$value": "0.375rem",
      "$type": "dimension"
    },
    "lg": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "xl": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-serif, Georgia, Cambria, 'Times New Roman', serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(255 255 255 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(255 255 255 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(255 255 255 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(255 255 255 / 0.12)",
      "$type": "shadow"
    }
  }
}
