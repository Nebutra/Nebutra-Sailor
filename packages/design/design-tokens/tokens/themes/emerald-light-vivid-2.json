{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Community theme — Emerald primary, vivid chroma, light surface",
  "theme": "emerald-light-vivid-2",
  "color": {
    "primary": {
      "$value": "#3ecf8e",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.830 0.098 161.8)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "accent": {
      "$value": "#24b47e",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "background": {
      "$value": "#3ecf8e",
      "$type": "color"
    },
    "foreground": {
      "$value": "#171717",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.855 0.104 166.5)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#171717",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.846 0.102 165.0)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#171717",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.838 0.100 163.4)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.593 0.037 117.3)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.822 0.095 160.3)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.830 0.098 161.8)",
      "$type": "color"
    },
    "ring": {
      "$value": "#3ecf8e",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #3ecf8e, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #3ecf8e, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #3ecf8e 0%, #24b47e 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "0.25rem",
      "$type": "dimension"
    },
    "md": {
      "$value": "0.375rem",
      "$type": "dimension"
    },
    "lg": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "xl": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(62 207 142 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(62 207 142 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(62 207 142 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(62 207 142 / 0.12)",
      "$type": "shadow"
    }
  }
}
