{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Vivid sapphire on pale mist — clear, open, airy",
  "theme": "cyan-dim-vivid",
  "color": {
    "primary": {
      "$value": "#3E6AE1",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.970 0.012 262.1)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "accent": {
      "$value": "#3E6AE1",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "background": {
      "$value": "oklch(0.99 0.004 262.1)",
      "$type": "color"
    },
    "foreground": {
      "$value": "#3E6AE1",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.985 0.006 262.1)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#3E6AE1",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.980 0.008 262.1)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#3E6AE1",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.975 0.010 262.1)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.831 0.072 262.1)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.966 0.014 262.1)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.970 0.012 262.1)",
      "$type": "color"
    },
    "ring": {
      "$value": "#3E6AE1",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #3E6AE1, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #3E6AE1, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #3E6AE1 0%, #3E6AE1 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "0.25rem",
      "$type": "dimension"
    },
    "md": {
      "$value": "0.375rem",
      "$type": "dimension"
    },
    "lg": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "xl": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(62 106 225 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(62 106 225 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(62 106 225 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(62 106 225 / 0.12)",
      "$type": "shadow"
    }
  }
}
