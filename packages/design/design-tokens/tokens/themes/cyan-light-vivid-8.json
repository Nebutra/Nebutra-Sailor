{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Vivid cobalt on deep dark — bold night mode energy",
  "theme": "cyan-light-vivid-8",
  "color": {
    "primary": {
      "$value": "#0070d1",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.313 0.004 300.7)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "accent": {
      "$value": "#0064b7",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "background": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.193 0.005 290.3)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.210 0.005 291.8)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.244 0.004 294.8)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.699 0.002 334.1)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.330 0.004 302.2)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.296 0.004 299.2)",
      "$type": "color"
    },
    "ring": {
      "$value": "#0070d1",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #0070d1, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #0070d1, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #0070d1 0%, #0064b7 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "4px",
      "$type": "dimension"
    },
    "md": {
      "$value": "8px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "16px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(0 112 209 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(0 112 209 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(0 112 209 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(0 112 209 / 0.12)",
      "$type": "shadow"
    }
  }
}
