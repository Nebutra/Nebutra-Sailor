{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Community theme — Rose primary, vivid chroma, light surface",
  "theme": "rose-light-vivid-3",
  "color": {
    "primary": {
      "$value": "#fa520f",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.960 0.000 89.9)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "accent": {
      "$value": "#cc3a05",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "background": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "foreground": {
      "$value": "#1f1f1f",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.990 0.000 89.9)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#1f1f1f",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.980 0.000 89.9)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#1f1f1f",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.970 0.000 89.9)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.672 0.000 89.9)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.950 0.000 89.9)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.960 0.000 89.9)",
      "$type": "color"
    },
    "ring": {
      "$value": "#fa520f",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #fa520f, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #fa520f, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #fa520f 0%, #cc3a05 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "6px",
      "$type": "dimension"
    },
    "md": {
      "$value": "8px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "12px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "16px",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(250 82 15 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(250 82 15 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(250 82 15 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(250 82 15 / 0.12)",
      "$type": "shadow"
    }
  }
}
