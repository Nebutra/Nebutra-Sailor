{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Community theme — Azure primary, vivid chroma, light surface",
  "theme": "azure-dark-vivid",
  "color": {
    "primary": {
      "$value": "#0007cd",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.922 0.004 265.8)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "accent": {
      "$value": "#0005a3",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "background": {
      "$value": "oklch(0.99 0.004 264.1)",
      "$type": "color"
    },
    "foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.973 0.004 264.5)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.956 0.004 265.0)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.939 0.004 265.4)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.438 0.005 278.3)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.905 0.004 266.3)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.922 0.004 265.8)",
      "$type": "color"
    },
    "ring": {
      "$value": "#0007cd",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #0007cd, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #0007cd, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #0007cd 0%, #0005a3 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "6px",
      "$type": "dimension"
    },
    "md": {
      "$value": "8px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "12px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "16px",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(0 7 205 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(0 7 205 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(0 7 205 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(0 7 205 / 0.12)",
      "$type": "shadow"
    }
  }
}
