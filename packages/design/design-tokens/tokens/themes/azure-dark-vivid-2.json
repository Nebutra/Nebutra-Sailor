{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Dusky periwinkle on true black — calm intelligence",
  "theme": "azure-dark-vivid-2",
  "color": {
    "primary": {
      "$value": "#5e6ad2",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.328 0.015 266.7)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "accent": {
      "$value": "#828fff",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "background": {
      "$value": "#010102",
      "$type": "color"
    },
    "foreground": {
      "$value": "#f7f8f8",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.212 0.018 278.9)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#f7f8f8",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.228 0.017 277.1)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#f7f8f8",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.261 0.017 273.7)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.700 0.007 227.5)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.344 0.015 265.0)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.311 0.016 268.4)",
      "$type": "color"
    },
    "ring": {
      "$value": "#5e6ad2",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #5e6ad2, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #5e6ad2, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #5e6ad2 0%, #828fff 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "6px",
      "$type": "dimension"
    },
    "md": {
      "$value": "8px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "12px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "16px",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(94 106 210 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(94 106 210 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(94 106 210 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(94 106 210 / 0.12)",
      "$type": "shadow"
    }
  }
}
