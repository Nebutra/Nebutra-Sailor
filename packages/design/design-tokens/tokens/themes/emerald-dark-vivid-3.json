{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Vivid jade on near-black — lush, technical, distinctive",
  "theme": "emerald-dark-vivid-3",
  "color": {
    "primary": {
      "$value": "#00d992",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.514 0.000 89.9)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "accent": {
      "$value": "#2fd6a1",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "background": {
      "$value": "#101010",
      "$type": "color"
    },
    "foreground": {
      "$value": "#f2f2f2",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.432 0.000 89.9)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#f2f2f2",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.444 0.000 89.9)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#f2f2f2",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.467 0.000 89.9)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.778 0.000 89.9)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.526 0.000 89.9)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.502 0.000 89.9)",
      "$type": "color"
    },
    "ring": {
      "$value": "#00d992",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #00d992, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #00d992, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #00d992 0%, #2fd6a1 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "6px",
      "$type": "dimension"
    },
    "md": {
      "$value": "8px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "xl": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(0 217 146 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(0 217 146 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(0 217 146 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(0 217 146 / 0.12)",
      "$type": "shadow"
    }
  }
}
