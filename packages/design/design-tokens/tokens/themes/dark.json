    "ambient-sm": {
      "$value": "0 1px 2px -1px rgb(0 0 0 / 0.4), 0 6px 16px -6px rgb(0 0 0 / 0.5)",
      "$type": "shadow",
      "$description": "Ambient elevation, small. Contact layer plus a wide soft pool — the marketing-surface counterpart to the tight xs..2xl product ramp."
    },
    "ambient-md": {
      "$value": "0 2px 4px -2px rgb(0 0 0 / 0.4), 0 12px 32px -10px rgb(0 0 0 / 0.55)",
      "$type": "shadow",
      "$description": "Ambient elevation, medium. Default resting depth for a floating marketing card."
    },
    "ambient-lg": {
      "$value": "0 4px 8px -4px rgb(0 0 0 / 0.4), 0 24px 56px -18px rgb(0 0 0 / 0.6)",
      "$type": "shadow",
      "$description": "Ambient elevation, large. One step up from md; use for hover of a md surface, not as a resting default."
    },
    "glass-sm": {
      "$value": "inset 0 1px 0 rgb(255 255 255 / 0.08), 0 1px 2px -1px rgb(0 0 0 / 0.4), 0 6px 16px -6px rgb(0 0 0 / 0.5)",
      "$type": "shadow",
      "$description": "Ambient-sm plus a lit top edge, for translucent panels over a blurred backdrop."
    },
    "glass-md": {
      "$value": "inset 0 1px 0 rgb(255 255 255 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.4), 0 12px 32px -10px rgb(0 0 0 / 0.55)",
      "$type": "shadow",
      "$description": "Ambient-md plus a lit top edge."
    },
    "glass-lg": {
      "$value": "inset 0 1px 0 rgb(255 255 255 / 0.08), 0 4px 8px -4px rgb(0 0 0 / 0.4), 0 24px 56px -18px rgb(0 0 0 / 0.6)",
      "$type": "shadow",
      "$description": "Ambient-lg plus a lit top edge."
    },
    "sheen": {
      "$value": "inset 0 1px 0 rgb(0 0 0 / 0.12)",
      "$type": "shadow",
      "$description": "Top-edge sheen for solid inverted fills (bg-foreground). Lifts with light on a dark fill, with shade on a light one."
    },
    "ambient-glow": {
      "$value": "0 0 80px rgb(255 255 255 / 0.06)",
      "$type": "shadow",
      "$description": "Centred offsetless halo — the only non-directional step on the ramp. Inverted from the light value: a black halo has nothing to darken against a dark surround, so the halo becomes light. Keep the alpha low; this is separation, not a bloom."
    },
    "glow-accent": {
      "$value": "0 8px 32px rgb(0 0 0 / 0.4), 0 0 60px color-mix(in srgb, var(--brand-accent) 8%, transparent)",
      "$type": "shadow",
      "$description": "Identical to the light value by design. The pool is theme-invariant black because glow-accent surfaces are fixed dark glass in both themes; only the accent halo shifts, via --brand-accent."
    },
    "glow-accent-lg": {
      "$value": "0 12px 48px rgb(0 0 0 / 0.5), 0 0 80px color-mix(in srgb, var(--brand-accent) 12%, transparent)",
      "$type": "shadow",
      "$description": "Hover escalation of glow-accent. Identical to the light value by design."
    },
    "glow-accent-sm": {
      "$value": "0 0 20px color-mix(in srgb, var(--brand-accent) 10%, transparent)",
      "$type": "shadow",
      "$description": "Accent halo alone, no pool. Identical to the light value by design."
    },
    "glow-primary": {
      "$value": "0 20px 25px -5px hsl(var(--primary) / 0.05), 0 8px 10px -6px hsl(var(--primary) / 0.05)",
      "$type": "shadow",
      "$description": "xl geometry tinted with the action fill at 5 percent. Same reference as light; --primary carries the dark channels."
    }
  }
}
