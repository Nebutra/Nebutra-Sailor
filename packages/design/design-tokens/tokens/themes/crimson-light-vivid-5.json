{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Electric red on white — charged, high-stakes, decisive",
  "theme": "crimson-light-vivid-5",
  "color": {
    "primary": {
      "$value": "#e60000",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.963 0.001 102.5)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "accent": {
      "$value": "#e60000",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "background": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "foreground": {
      "$value": "#25282b",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.991 0.000 93.0)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#25282b",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.981 0.000 96.2)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#25282b",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.972 0.000 99.3)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.699 0.005 191.9)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.954 0.001 105.6)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.963 0.001 102.5)",
      "$type": "color"
    },
    "ring": {
      "$value": "#e60000",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #e60000, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #e60000, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #e60000 0%, #e60000 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "6px",
      "$type": "dimension"
    },
    "md": {
      "$value": "0.375rem",
      "$type": "dimension"
    },
    "lg": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "xl": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(230 0 0 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(230 0 0 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(230 0 0 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(230 0 0 / 0.12)",
      "$type": "shadow"
    }
  }
}
