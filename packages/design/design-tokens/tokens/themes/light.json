    "muted-foreground": {
      "$value": "215 25% 45%",
      "$type": "string"
    },
    "accent": {
      "$value": "228 100% 97%",
      "$type": "string"
    },
    "accent-foreground": {
      "$value": "228 85% 56%",
      "$type": "string",
      "$description": "Softer brand blue — desaturated to match --primary, avoids 100% saturation glare on focus/accent"
    },
    "destructive": {
      "$value": "0 84% 45%",
      "$type": "string"
    },
    "destructive-foreground": {
      "$value": "0 0% 100%",
      "$type": "string"
    },
    "destructive-strong": {
      "$value": "0 84% 45%",
      "$type": "string",
      "$description": "Red as FOREGROUND. In light mode --destructive already passes (5.42:1 on white), so this equals it; the token exists so consumers reference one name across themes. In DARK, --destructive is 0 63% 38% = 2.15:1 on --card, unreadable as text — see dark.json. Mirrors --warning-strong."
    },
    "success": {
      "$value": "142 71% 29%",
      "$type": "string"
    },
    "success-foreground": {
      "$value": "0 0% 100%",
      "$type": "string"
    },
    "success-strong": {
      "$value": "142 71% 27%",
      "$type": "string",
      "$description": "Green as FOREGROUND. --success (142 71% 29%) is 5.15:1 on white but only 4.49:1 as ink on its own 10% tint — one hundredth under AA, which is where badge green-subtle sat. Darkened two points: 5.71:1 on white, 4.99:1 on the tint, alongside --warning-strong (5.40) and --destructive-strong (5.42) so the three status foregrounds read with the same weight. Completes the trio; use --success for fills with --success-foreground on top."
    },
    "warning": {
      "$value": "38 92% 50%",
      "$type": "string"
    },
    "warning-foreground": {
      "$value": "222 47% 11%",
      "$type": "string"
    },
    "warning-strong": {
      "$value": "38 92% 30%",
      "$type": "string",
      "$description": "Amber as FOREGROUND on a light surface. --warning is a fill: at 38 92% 50% it is 2.04:1 against --neutral-2, so it is unreadable as text or as an icon stroke. This darkened step is 5.17:1, which sits between --success (4.92) and --destructive (5.19) so the three status colours read with the same weight. Use --warning for fills with --warning-foreground on top; use this for amber text and icons. Destructive and success need no equivalent — they already pass AA as foreground."
    },
    "info": {
      "$value": "228 85% 56%",
      "$type": "string"
    },
    "info-foreground": {
      "$value": "0 0% 100%",
      "$type": "string"
    },
    "border": {
      "$value": "240 5.9% 90%",
      "$type": "string"
    },
    "input": {
      "$value": "240 5.9% 90%",
      "$type": "string"
    },
    "ring": {
      "$value": "222 47% 11%",
      "$type": "string",
      "$description": "Focus ring — neutral foreground (Vercel/Linear/Cursor 2026 pattern). Brand blue is reserved for selected/active states; focus indication is chrome and stays neutral. Consumed by global :focus-visible outline as hsl(var(--ring) / 0.5)."
    },
    "sidebar": {
