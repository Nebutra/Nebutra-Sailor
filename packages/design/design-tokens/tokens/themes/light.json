{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Light mode theme — 12-step functional scales (Geist-style) + shadcn HSL semantics + Geist DS scale + elevation. Mirrors :root in @nebutra/tokens/styles.css.",
  "scale": {
    "neutral": {
      "1": {
        "$value": "{color.white}",
        "$type": "color",
        "$description": "app background"
      },
      "2": {
        "$value": "{color.nebutra-neutral.50}",
        "$type": "color",
        "$description": "subtle background"
      },
      "3": {
        "$value": "{color.nebutra-neutral.100}",
        "$type": "color",
        "$description": "component bg default"
      },
      "4": {
        "$value": "{color.nebutra-neutral.200}",
        "$type": "color",
        "$description": "component bg hover"
      },
      "5": {
        "$value": "{color.nebutra-neutral.300}",
        "$type": "color",
        "$description": "component bg active"
      },
      "6": {
        "$value": "{scale.neutral.5}",
        "$type": "color",
        "$description": "subtle border — DERIVED at build time (scripts/derive-border-tier.mjs): OKLab lerp step5 → step9 at t=0.25. The $value here is a placeholder anchor only; the preprocessor overwrites it.",
        "$extensions": {
          "com.nebutra.derive": {
            "space": "oklab",
            "tier": "border"
          }
        }
      },
      "7": {
        "$value": "{scale.neutral.5}",
        "$type": "color",
        "$description": "default border — DERIVED: OKLab lerp step5 → step9 at t=0.50.",
        "$extensions": {
          "com.nebutra.derive": {
            "space": "oklab",
            "tier": "border"
          }
        }
      },
      "8": {
        "$value": "{scale.neutral.5}",
        "$type": "color",
        "$description": "hovered border — DERIVED: OKLab lerp step5 → step9 at t=0.75.",
        "$extensions": {
          "com.nebutra.derive": {
            "space": "oklab",
            "tier": "border"
          }
        }
      },
      "9": {
        "$value": "{color.nebutra-neutral.500}",
        "$type": "color",
        "$description": "solid fill"
      },
      "10": {
        "$value": "{color.nebutra-neutral.600}",
        "$type": "color",
        "$description": "solid fill hover"
      },
      "11": {
        "$value": "{color.nebutra-neutral.700}",
        "$type": "color",
        "$description": "secondary text"
      },
      "12": {
        "$value": "{color.nebutra-neutral.900}",
        "$type": "color",
        "$description": "primary text"
      }
    },
    "blue": {
      "1": {
        "$value": "{color.nebutra-blue.50}",
        "$type": "color"
      },
      "2": {
        "$value": "{color.nebutra-blue.100}",
        "$type": "color"
      },
      "3": {
        "$value": "{color.nebutra-blue.200}",
        "$type": "color"
      },
      "4": {
        "$value": "{color.nebutra-blue.300}",
        "$type": "color"
      },
      "5": {
        "$value": "{color.nebutra-blue.400}",
        "$type": "color"
      },
      "6": {
        "$value": "{scale.blue.5}",
        "$type": "color",
        "$description": "subtle border — DERIVED: OKLab lerp step5 → step9 at t=0.25.",
        "$extensions": {
          "com.nebutra.derive": {
            "space": "oklab",
            "tier": "border"
          }
        }
      },
      "7": {
        "$value": "{scale.blue.5}",
        "$type": "color",
        "$description": "default border — DERIVED: OKLab lerp step5 → step9 at t=0.50.",
        "$extensions": {
          "com.nebutra.derive": {
            "space": "oklab",
            "tier": "border"
          }
        }
      },
      "8": {
        "$value": "{scale.blue.5}",
        "$type": "color",
        "$description": "hovered border — DERIVED: OKLab lerp step5 → step9 at t=0.75.",
        "$extensions": {
          "com.nebutra.derive": {
            "space": "oklab",
            "tier": "border"
          }
        }
      },
      "9": {
        "$value": "{color.nebutra-blue.500}",
        "$type": "color",
        "$description": "solid fill — main brand"
      },
      "10": {
        "$value": "{color.nebutra-blue.600}",
        "$type": "color"
      },
      "11": {
        "$value": "{color.nebutra-blue.700}",
        "$type": "color"
      },
      "12": {
        "$value": "{color.nebutra-blue.900}",
        "$type": "color"
      }
    },
    "cyan": {
      "1": {
        "$value": "{color.nebutra-cyan.50}",
        "$type": "color"
      },
      "2": {
        "$value": "{color.nebutra-cyan.100}",
        "$type": "color"
      },
      "3": {
        "$value": "{color.nebutra-cyan.200}",
        "$type": "color"
      },
      "4": {
        "$value": "{color.nebutra-cyan.300}",
        "$type": "color"
      },
      "5": {
        "$value": "{color.nebutra-cyan.400}",
        "$type": "color"
      },
      "6": {
        "$value": "{scale.cyan.5}",
        "$type": "color",
        "$description": "subtle border — DERIVED: bright-scale fallback (|L9−L5| = 0.017 < 0.06), so the anchor is step 10, not step 9. OKLab lerp step5 → step10 at t=0.25.",
        "$extensions": {
          "com.nebutra.derive": {
            "space": "oklab",
            "tier": "border"
          }
        }
      },
      "7": {
        "$value": "{scale.cyan.5}",
        "$type": "color",
        "$description": "default border — DERIVED: OKLab lerp step5 → step10 at t=0.50 (bright-scale fallback).",
        "$extensions": {
          "com.nebutra.derive": {
            "space": "oklab",
            "tier": "border"
          }
        }
      },
      "8": {
        "$value": "{scale.cyan.5}",
        "$type": "color",
        "$description": "hovered border — DERIVED: OKLab lerp step5 → step10 at t=0.75 (bright-scale fallback).",
        "$extensions": {
          "com.nebutra.derive": {
            "space": "oklab",
            "tier": "border"
          }
        }
      },
      "9": {
        "$value": "{color.nebutra-cyan.500}",
        "$type": "color"
      },
      "10": {
        "$value": "{color.nebutra-cyan.600}",
        "$type": "color"
      },
      "11": {
        "$value": "{color.nebutra-cyan.700}",
        "$type": "color"
      },
      "12": {
        "$value": "{color.nebutra-cyan.900}",
        "$type": "color"
      }
    }
  },
