  "elevation": {
    "xs": {
      "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
      "$type": "shadow"
    },
    "sm": {
      "$value": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)",
      "$type": "shadow"
    },
    "2xl": {
      "$value": "0 25px 50px -12px rgb(0 0 0 / 0.25)",
      "$type": "shadow"
    },
    "brand": {
      "$value": "0 0 0 1px rgb(0 51 254 / 0.15), 0 4px 20px -2px rgb(0 51 254 / 0.2)",
      "$type": "shadow"
    },
    "brand-lg": {
      "$value": "0 0 0 1px rgb(0 51 254 / 0.2), 0 8px 40px -4px rgb(0 51 254 / 0.3)",
      "$type": "shadow"
    },
    "ambient-sm": {
      "$value": "0 1px 2px -1px hsl(222 47% 11% / 0.06), 0 6px 16px -6px hsl(222 47% 11% / 0.12)",
      "$type": "shadow",
      "$description": "Ambient elevation, small. Contact layer plus a wide soft pool — the marketing-surface counterpart to the tight xs..2xl product ramp."
    },
    "ambient-md": {
      "$value": "0 2px 4px -2px hsl(222 47% 11% / 0.06), 0 12px 32px -10px hsl(222 47% 11% / 0.14)",
      "$type": "shadow",
      "$description": "Ambient elevation, medium. Default resting depth for a floating marketing card."
    },
    "ambient-lg": {
      "$value": "0 4px 8px -4px hsl(222 47% 11% / 0.06), 0 24px 56px -18px hsl(222 47% 11% / 0.16)",
      "$type": "shadow",
      "$description": "Ambient elevation, large. One step up from md; use for hover of a md surface, not as a resting default."
    },
    "glass-sm": {
      "$value": "inset 0 1px 0 rgb(255 255 255 / 0.5), 0 1px 2px -1px hsl(222 47% 11% / 0.06), 0 6px 16px -6px hsl(222 47% 11% / 0.12)",
      "$type": "shadow",
      "$description": "Ambient-sm plus a lit top edge, for translucent panels over a blurred backdrop."
    },
    "glass-md": {
      "$value": "inset 0 1px 0 rgb(255 255 255 / 0.5), 0 2px 4px -2px hsl(222 47% 11% / 0.06), 0 12px 32px -10px hsl(222 47% 11% / 0.14)",
      "$type": "shadow",
      "$description": "Ambient-md plus a lit top edge."
    },
    "glass-lg": {
      "$value": "inset 0 1px 0 rgb(255 255 255 / 0.5), 0 4px 8px -4px hsl(222 47% 11% / 0.06), 0 24px 56px -18px hsl(222 47% 11% / 0.16)",
      "$type": "shadow",
      "$description": "Ambient-lg plus a lit top edge."
    },
    "sheen": {
      "$value": "inset 0 1px 0 rgb(255 255 255 / 0.2)",
      "$type": "shadow",
      "$description": "Top-edge sheen for solid inverted fills (bg-foreground). Lifts with light on a dark fill, with shade on a light one."
    },
    "ambient-glow": {
      "$value": "0 0 80px hsl(222 47% 11% / 0.1)",
      "$type": "shadow",
      "$description": "Centred offsetless halo — the only non-directional step on the ramp. For a translucent panel that needs separation from its backdrop without reading as lifted off a surface. In dark mode this inverts to a low-alpha light halo, because a black halo cannot read against a dark surround."
    },
    "glow-accent": {
      "$value": "0 8px 32px rgb(0 0 0 / 0.4), 0 0 60px color-mix(in srgb, var(--brand-accent) 8%, transparent)",
      "$type": "shadow",
      "$description": "Directional pool plus a wide brand-accent halo, for fixed dark-glass surfaces. The pool is theme-invariant black on purpose: the surfaces that carry an accent halo present the same dark glass in both themes, so a theme-flipping pool would lighten in light mode exactly where the panel needs the most separation. Accent sourced from --brand-accent, so it follows the light and dark accent values."
    },
    "glow-accent-lg": {
      "$value": "0 12px 48px rgb(0 0 0 / 0.5), 0 0 80px color-mix(in srgb, var(--brand-accent) 12%, transparent)",
      "$type": "shadow",
      "$description": "Hover escalation of glow-accent. Deeper pool, wider and stronger accent halo."
    },
    "glow-accent-sm": {
      "$value": "0 0 20px color-mix(in srgb, var(--brand-accent) 10%, transparent)",
      "$type": "shadow",
      "$description": "Accent halo alone, no pool. For a small accent-tinted chip or icon plate inside a glow-accent surface."
    },
    "glow-primary": {
      "$value": "0 20px 25px -5px hsl(var(--primary) / 0.05), 0 8px 10px -6px hsl(var(--primary) / 0.05)",
      "$type": "shadow",
