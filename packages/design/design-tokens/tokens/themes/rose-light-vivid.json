{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Warm terracotta on cream — organic, considered, sun-baked",
  "theme": "rose-light-vivid",
  "color": {
    "primary": {
      "$value": "#cc785c",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.947 0.002 96.0)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "accent": {
      "$value": "#a9583e",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "background": {
      "$value": "#faf9f5",
      "$type": "color"
    },
    "foreground": {
      "$value": "#141413",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.981 0.002 95.3)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#141413",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.969 0.002 95.6)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#141413",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.958 0.002 95.8)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.625 0.003 102.5)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.935 0.002 96.2)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.947 0.002 96.0)",
      "$type": "color"
    },
    "ring": {
      "$value": "#cc785c",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #cc785c, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #cc785c, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #cc785c 0%, #a9583e 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "6px",
      "$type": "dimension"
    },
    "md": {
      "$value": "8px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "12px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "16px",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(204 120 92 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(204 120 92 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(204 120 92 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(204 120 92 / 0.12)",
      "$type": "shadow"
    }
  }
}
