{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Community theme — Amber primary, vivid chroma, dark surface",
  "theme": "amber-light-vivid-3",
  "color": {
    "primary": {
      "$value": "#ffed00",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.328 0.004 85.8)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "accent": {
      "$value": "#e6d200",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "background": {
      "$value": "oklch(0.16 0.005 107.3)",
      "$type": "color"
    },
    "foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.210 0.005 100.9)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.227 0.005 98.7)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.261 0.004 94.4)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.706 0.002 37.6)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.345 0.004 83.7)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.311 0.004 88.0)",
      "$type": "color"
    },
    "ring": {
      "$value": "#ffed00",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #ffed00, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #ffed00, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #ffed00 0%, #e6d200 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "3px",
      "$type": "dimension"
    },
    "md": {
      "$value": "4px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "xl": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(255 237 0 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(255 237 0 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(255 237 0 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(255 237 0 / 0.12)",
      "$type": "shadow"
    }
  }
}
