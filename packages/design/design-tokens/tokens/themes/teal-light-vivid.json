{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Electric teal-mint on deep dark — Arctic clarity, crisp",
  "theme": "teal-light-vivid",
  "color": {
    "primary": {
      "$value": "#3cffd0",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.313 0.027 180.5)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "accent": {
      "$value": "#5200ff",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "background": {
      "$value": "oklch(0.16 0.005 180.5)",
      "$type": "color"
    },
    "foreground": {
      "$value": "#3cffd0",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.206 0.012 180.5)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#3cffd0",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.221 0.014 180.5)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#3cffd0",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.252 0.018 180.5)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.656 0.077 180.5)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.328 0.029 180.5)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.297 0.025 180.5)",
      "$type": "color"
    },
    "ring": {
      "$value": "#3cffd0",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #3cffd0, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #3cffd0, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #3cffd0 0%, #5200ff 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "0.25rem",
      "$type": "dimension"
    },
    "md": {
      "$value": "0.375rem",
      "$type": "dimension"
    },
    "lg": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "xl": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(60 255 208 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(60 255 208 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(60 255 208 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(60 255 208 / 0.12)",
      "$type": "shadow"
    }
  }
}
