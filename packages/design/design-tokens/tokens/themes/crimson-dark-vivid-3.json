{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Community theme — Crimson primary, vivid chroma, dark surface",
  "theme": "crimson-dark-vivid-3",
  "color": {
    "primary": {
      "$value": "#f36458",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.481 0.000 71.9)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "accent": {
      "$value": "#0052ef",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "background": {
      "$value": "#0b0b0b",
      "$type": "color"
    },
    "foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.390 0.000 84.5)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.403 0.000 82.7)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.429 0.000 79.1)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.773 0.000 31.5)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.494 0.000 70.1)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.468 0.000 73.7)",
      "$type": "color"
    },
    "ring": {
      "$value": "#f36458",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #f36458, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #f36458, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #f36458 0%, #0052ef 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "0.25rem",
      "$type": "dimension"
    },
    "md": {
      "$value": "0.375rem",
      "$type": "dimension"
    },
    "lg": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "xl": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(243 100 88 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(243 100 88 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(243 100 88 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(243 100 88 / 0.12)",
      "$type": "shadow"
    }
  }
}
