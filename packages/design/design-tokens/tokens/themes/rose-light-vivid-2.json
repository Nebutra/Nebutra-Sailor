{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Community theme — Rose primary, vivid chroma, light surface",
  "theme": "rose-light-vivid-2",
  "color": {
    "primary": {
      "$value": "#f54e00",
      "$type": "color"
    },
    "primary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(0.952 0.003 105.9)",
      "$type": "color"
    },
    "secondary-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "accent": {
      "$value": "#d04200",
      "$type": "color"
    },
    "accent-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "background": {
      "$value": "#f7f7f4",
      "$type": "color"
    },
    "foreground": {
      "$value": "#26251e",
      "$type": "color"
    },
    "card": {
      "$value": "oklch(0.980 0.002 106.3)",
      "$type": "color"
    },
    "card-foreground": {
      "$value": "#26251e",
      "$type": "color"
    },
    "popover": {
      "$value": "oklch(0.970 0.003 106.2)",
      "$type": "color"
    },
    "popover-foreground": {
      "$value": "#26251e",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(0.961 0.003 106.1)",
      "$type": "color"
    },
    "muted-foreground": {
      "$value": "oklch(0.687 0.010 102.7)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(0.943 0.003 105.8)",
      "$type": "color"
    },
    "input": {
      "$value": "oklch(0.952 0.003 105.9)",
      "$type": "color"
    },
    "ring": {
      "$value": "#f54e00",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklch, #f54e00, white 12%)",
      "$type": "color"
    },
    "primary-active": {
      "$value": "color-mix(in oklch, #f54e00, black 10%)",
      "$type": "color"
    },
    "brand-gradient": {
      "$value": "linear-gradient(135deg, #f54e00 0%, #d04200 100%)",
      "$type": "color"
    },
    "destructive": {
      "$value": "oklch(0.577 0.245 27.3)",
      "$type": "color"
    },
    "destructive-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "success": {
      "$value": "oklch(0.723 0.19 149.6)",
      "$type": "color"
    },
    "success-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    },
    "warning": {
      "$value": "oklch(0.795 0.184 86.0)",
      "$type": "color"
    },
    "warning-foreground": {
      "$value": "oklch(0.141 0.005 285.9)",
      "$type": "color"
    },
    "info": {
      "$value": "oklch(0.588 0.158 241.9)",
      "$type": "color"
    },
    "info-foreground": {
      "$value": "oklch(1 0 0)",
      "$type": "color"
    }
  },
  "radius": {
    "sm": {
      "$value": "6px",
      "$type": "dimension"
    },
    "md": {
      "$value": "8px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "12px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "16px",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(245 78 0 / 0.08)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(245 78 0 / 0.12)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(245 78 0 / 0.12)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(245 78 0 / 0.12)",
      "$type": "shadow"
    }
  }
}
