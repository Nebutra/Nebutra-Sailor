{
  "name": "@nebutra/tokens",
  "version": "0.1.2",
  "description": "Unified theme tokens and theme-provider entry for Nebutra apps",
  "private": false,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./styles.css",
    "./recipe.css",
    "./skins/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styles.css",
    "./recipe.css": "./recipe.css",
    "./skins/*": "./skins/*",
    "./brands/*": "./brands/*",
    "./brand-package": "./src/brand-package/index.ts",
    "./use-brand": "./src/brand-package/use-brand.ts"
  },
  "scripts": {
    "build": "node scripts/sync-styles.mjs && node scripts/emit-skins.mjs",
    "sync": "node scripts/sync-styles.mjs",
    "emit-skins": "node scripts/emit-skins.mjs",
    "compile-brand": "node scripts/compile-brand.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/brand-package/__tests__/*.test.ts"
  },
  "dependencies": {
    "@nebutra/design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19.2.14",
    "typescript": "catalog:"
  },
  "homepage": "https://github.com/Nebutra/Nebutra-Sailor/tree/main/packages/design/tokens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nebutra/Nebutra-Sailor.git",
    "directory": "packages/design/tokens"
  },
  "bugs": {
    "url": "https://github.com/Nebutra/Nebutra-Sailor/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
