{
  "extends": ["//"],
  "tasks": {
    "build": {
      // ^build keeps the workspace dependencies (@nebutra/brand, @nebutra/fonts)
      // built first: a package-level dependsOn replaces the root's, and without
      // it src/preset/schema.ts could not resolve @nebutra/brand/metadata-helpers.
      "dependsOn": ["^build", "@nebutra/design-tokens#build"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "../design-tokens/build/css/styles.generated.css",
        "brands/**",
        "scripts/**"
      ],
      // dist/** is required: design-sync (and others) import
      // @nebutra/tokens/brand-package from dist. Omitting it made turbo
      // cache hits restore only CSS and leave dist/ empty → TS2307 on ECS.
      "outputs": ["styles.css", "skins/**", "dist/**"]
    }
  }
}
