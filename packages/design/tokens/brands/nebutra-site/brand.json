  "typography": {
    "fontSans": "'Geist', 'MiSans', ui-sans-serif, system-ui, sans-serif",
    "fontDisplay": "'DM Sans', 'MiSans', ui-sans-serif, sans-serif",
    "fontMono": "'Geist Mono', ui-monospace, monospace",
    "headingWeight": 500
