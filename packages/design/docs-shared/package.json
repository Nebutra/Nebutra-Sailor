{
  "name": "@nebutra/docs-shared",
  "version": "0.1.1",
  "private": true,
  "nebutra": {
    "status": "foundation",
    "graph": "core",
    "productionReady": false
  },
  "type": "module",
  "description": "Shared UI/docs components for design-docs and sailor-docs (byte-identical SSOT)",
  "license": "MIT",
  "exports": {
    "./components/previews/*": [
      "./src/components/previews/*.tsx",
      "./src/components/previews/*.ts"
    ],
    "./components/previews": [
      "./src/components/previews/index.ts"
    ],
    "./components/*": [
      "./src/components/*.tsx",
      "./src/components/*.ts",
      "./src/components/*"
    ],
    "./*": [
      "./src/*.tsx",
      "./src/*.ts",
      "./src/*"
    ]
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "next": ">=15",
    "fumadocs-ui": "*",
    "fumadocs-openapi": "*",
    "class-variance-authority": "*",
    "input-otp": "*",
    "react-resizable-panels": "*",
    "zod": "*"
  },
  "dependencies": {
    "@nebutra/brand": "workspace:*",
    "@nebutra/icons": "workspace:*",
    "@nebutra/tokens": "workspace:*",
    "@nebutra/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:"
  },
  "types": "./src/components",
  "scripts": {
    "gen:previews": "node scripts/gen-previews.mjs"
  }
}
