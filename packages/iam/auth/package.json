{
  "name": "@nebutra/auth",
  "version": "1.0.0",
  "private": true,
  "nebutra": {
    "status": "foundation",
    "graph": "core",
    "productionReady": false
  },
  "description": "Provider-agnostic auth abstraction layer (Clerk, Better Auth, NextAuth/Auth.js v5, Supabase)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./desktop": {
      "types": "./dist/desktop-auth.d.ts",
      "import": "./dist/desktop-auth.js",
      "default": "./dist/desktop-auth.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./s2s": {
      "types": "./dist/s2s.d.ts",
      "import": "./dist/s2s.js",
      "default": "./dist/s2s.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "default": "./dist/middleware.js"
    },
    "./react/context": {
      "types": "./dist/react/context.d.ts",
      "import": "./dist/react/context.js",
      "default": "./dist/react/context.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./react/clerk-enterprise-sso": {
      "types": "./dist/react/use-clerk-enterprise-sso.d.ts",
      "import": "./dist/react/use-clerk-enterprise-sso.js",
      "default": "./dist/react/use-clerk-enterprise-sso.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@better-auth/core": "^1.6.13",
    "@nebutra/audit": "workspace:*",
    "@nebutra/email": "workspace:*",
    "@nebutra/logger": "workspace:*",
    "@simplewebauthn/server": "^13.3.0",
    "better-auth": "^1.6.13",
    "jose": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@clerk/nextjs": ">=6.0.0",
    "@nebutra/db": "workspace:*",
    "@nebutra/feature-flags": "workspace:*",
    "@supabase/supabase-js": ">=2.0.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "@nebutra/ui": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@clerk/nextjs": {
      "optional": true
    },
    "next-auth": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    },
    "@nebutra/db": {
      "optional": true
    },
    "@nebutra/feature-flags": {
      "optional": true
    },
    "@nebutra/ui": {
      "optional": true
    }
  },
  "license": "AGPL-3.0-only",
  "files": [
    "dist"
  ]
}
