{
  "name": "@nebutra/license",
  "version": "0.1.4",
  "description": "License domain logic \u2014 issuance, validation, and lifecycle events",
  "private": false,
  "license": "MIT",
  "type": "module",
  "nebutra": {
    "graph": "core",
    "featureId": "license",
    "category": "commerce",
    "summary": "License key generation + validation",
    "status": "foundation",
    "productionReady": false,
    "requires": [
      "Host-injected getSystemDb via configureLicenseSystemDb",
      "@nebutra/queue for license.issued fan-out",
      "@nebutra/email for welcome mail (handler)"
    ],
    "gaps": [
      "Persistence is host-injected \u2014 the package defines a LicenseDb interface and deliberately never imports @nebutra/db",
      "Issuance sends through @nebutra/email, so a working email provider must be configured before a key reaches anyone",
      "No UI surface: key entry, activation and portal screens belong to the consuming app"
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./handlers": {
      "types": "./dist/handlers/index.d.ts",
      "import": "./dist/handlers/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nebutra/email": "workspace:*",
    "@nebutra/logger": "workspace:*",
    "@nebutra/queue": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "homepage": "https://github.com/Nebutra/Nebutra-Sailor/tree/main/packages/commerce/license#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nebutra/Nebutra-Sailor.git",
    "directory": "packages/commerce/license"
  },
  "bugs": {
    "url": "https://github.com/Nebutra/Nebutra-Sailor/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
