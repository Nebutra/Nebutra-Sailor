  "optionalDependencies": {
    "sharp": "^0.35.0"
  },
  "peerDependencies": {
    "@nebutra/ai-providers": "workspace:*",
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@nebutra/ai-providers": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nebutra/ai-providers": "workspace:*",
    "@types/csso": "^5.0.4",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "catalog:",
