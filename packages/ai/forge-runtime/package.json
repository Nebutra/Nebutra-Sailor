{
  "name": "@nebutra/forge-runtime",
  "version": "0.1.0",
  "description": "Nebutra Forge capability registry, invoke pipeline, pure tools, and human page models",
  "private": false,
  "license": "MIT",
  "type": "module",
  "nebutra": {
    "status": "wip",
    "productionReady": false,
    "surface": "execution-capability",
    "featureId": "forge-runtime",
    "category": "ai",
    "summary": "Tool-station capability registry + dual-surface invoke for forge.nebutra.com",
    "gaps": [
      "kinship / phone-lookup / router-translate deferred until SOTA engines (hard-correct)",
      "Host metering dual-write still injected per-request (not package-default)",
      "md-to-pdf requires Playwright Chromium on product hosts (fail-closed without it)"
    ]
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pdf": "./src/tools/md-to-pdf.ts",
    "./vin": "./src/tools/w3-vin.ts",
    "./secret-scan": "./src/tools/w3-secret-scan.ts",
    "./yaml-diff": "./src/tools/w3-yaml-diff.ts",
    "./env-diff": "./src/tools/w3-env-diff.ts",
    "./list-set-compare": "./src/tools/w3-list-set-compare.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "skills:generate": "vitest run src/generate-core-skills.test.ts"
  },
  "dependencies": {
    "@dbml/core": "^9.1.1",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "cron-parser": "^5.5.0",
    "csso": "^5.0.5",
    "culori": "^4.0.2",
    "dayjs": "^1.11.21",
    "diff": "^7.0.0",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.8.0",
    "he": "^1.2.0",
    "html-minifier-terser": "^7.2.0",
    "jose": "^6.2.0",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "^5.2.1",
    "jsonpath-plus": "^10.4.0",
    "jsqr": "^1.4.0",
    "lunar-javascript": "^1.7.7",
    "marked": "^15.0.12",
    "mermaid": "catalog:",
    "nanoid": "^6.0.0",
    "opencc-js": "^1.4.1",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pinyin-pro": "^3.28.2",
    "prettier": "^3.8.1",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.6.1",
