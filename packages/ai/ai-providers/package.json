{
  "name": "@nebutra/ai-providers",
  "version": "1.0.0",
  "private": true,
  "description": "Provider registry metadata for Nebutra — meta-only, consumed by @nebutra/create-sailor and docs. Runtime lives in @nebutra/agents.",
  "sideEffects": false,
  "type": "module",
  "nebutra": {
    "featureId": "ai-providers",
    "category": "ai",
    "surface": "provider-metadata",
    "summary": "Provider metadata only; runtime execution belongs to @nebutra/agents",
    "status": "stable",
    "productionReady": true,
    "role": "meta-only",
    "runtime": "@nebutra/agents"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./meta": {
      "types": "./src/meta.ts",
      "import": "./src/meta.ts",
      "default": "./src/meta.ts"
    },
    "./catalog": {
      "types": "./src/catalog.ts",
      "import": "./src/catalog.ts",
      "default": "./src/catalog.ts"
    },
    "./frontier": {
      "types": "./src/frontier.ts",
      "import": "./src/frontier.ts",
      "default": "./src/frontier.ts"
    },
    "./templates/*": "./templates/*"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tokenlens/core": "^1.3.0",
    "@tokenlens/fetch": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "license": "AGPL-3.0-only"
}
