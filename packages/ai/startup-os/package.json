{
  "name": "@nebutra/startup-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "nebutra": {
    "status": "wip",
    "productionReady": false,
    "requires": [
      "@nebutra/agents for model execution and fallback routing",
      "@nebutra/agent-runtime for runtime policy grammar",
      "@nebutra/ui and @nebutra/icons for shared Startup OS presentation metadata"
    ],
    "gaps": [
      "Dashboard-facing adapters are still wired through app routes",
      "Long-running execution is represented by deterministic package seams until hosted orchestration is complete",
      "File and canvas operations are runtime contracts, not a standalone production surface"
    ],
    "featureId": "startup-os",
    "category": "ai",
    "surface": "product-orchestration",
    "summary": "Startup OS product orchestration contracts for company context, founder conversation, execution, files, and canvas state"
  },
  "main": "./src/compiler.ts",
  "types": "./src/compiler.ts",
  "exports": {
    "./canvas": "./src/canvas.ts",
    "./compiler": "./src/compiler.ts",
    "./conversation": "./src/conversation.ts",
    "./dev-tenant": "./src/dev-tenant.ts",
    "./execution": "./src/execution.ts",
    "./feature-flag": "./src/feature-flag.ts",
    "./files": "./src/files.ts",
    "./model-tier": "./src/model-tier.ts",
    "./rollout": "./src/rollout.ts",
    "./store": "./src/store.ts",
    "./company-context/*": "./src/company-context/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nebutra/agent-runtime": "workspace:*",
    "@nebutra/agents": "workspace:*",
    "@nebutra/db": "workspace:*",
    "@nebutra/icons": "workspace:*",
    "@nebutra/preset": "workspace:*",
    "@nebutra/ui": "workspace:*",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "AGPL-3.0-only"
}
