{
  "name": "@nebutra/forge-dns-leak",
  "version": "0.1.1",
  "description": "Authoritative DNS leak zone + session API for Nebutra Forge (dnsleaktest-style recursive resolver capture)",
  "private": false,
  "license": "MIT",
  "type": "module",
  "nebutra": {
    "status": "wip",
    "productionReady": false,
    "surface": "execution-capability",
    "featureId": "forge-dns-leak",
    "category": "ai",
    "summary": "UDP/TCP53 authority that logs recursive resolvers for unique leak probes; localhost control API for Forge"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "forge-dns-leak": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsup": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
