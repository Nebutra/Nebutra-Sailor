# Environment
NODE_ENV=development
PORT=3002

# Database (Supabase)
DATABASE_URL=postgresql://...

# Redis (Upstash)
# Preferred shared names across the monorepo:
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=xxx
# Backward-compatible aliases still accepted by the gateway:
# UPSTASH_REDIS_URL=https://...
# UPSTASH_REDIS_TOKEN=xxx

# Clerk
CLERK_SECRET_KEY=sk_test_xxx

# Service URLs (Railway)
AI_SERVICE_URL=http://localhost:8001
CONTENT_SERVICE_URL=http://localhost:8002
RECSYS_SERVICE_URL=http://localhost:8003
ECOMMERCE_SERVICE_URL=http://localhost:8004
WEB3_SERVICE_URL=http://localhost:8005
BILLING_SERVICE_URL=http://localhost:8006
EVENT_INGEST_SERVICE_URL=http://localhost:8008
INTERNAL_API_KEY=
# Must match GATEWAY_SHARED_SECRET on ECS/FastAPI origin.
# Gateway forwards it as x-nebutra-gateway-secret.
GATEWAY_SHARED_SECRET=

# Frontend URLs
LANDING_URL=http://localhost:3000
WEB_URL=http://localhost:3001

# ──────────────────────────────────────────────────────────────────────────
# Auth (multi-provider — matches @nebutra/auth)
# ──────────────────────────────────────────────────────────────────────────
AUTH_PROVIDER=clerk
AUTH_SECRET=
BETTER_AUTH_SECRET=
CLERK_WEBHOOK_SECRET=
NEXTAUTH_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# Domain config (used by CORS, redirect, cookie helpers)
# ──────────────────────────────────────────────────────────────────────────
DOMAIN_API=http://localhost:3002
DOMAIN_APP=http://localhost:3001
DOMAIN_LANDING=http://localhost:3000
DOMAIN_STUDIO=http://localhost:3003

# ──────────────────────────────────────────────────────────────────────────
# Database (ClickHouse — metering + analytics)
# ──────────────────────────────────────────────────────────────────────────
CLICKHOUSE_HTTP_URL=http://localhost:8123
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=nebutra
CLICKHOUSE_USER=default
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────
# Billing
# ──────────────────────────────────────────────────────────────────────────
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
NEBUTRA_BILLING_CHECKOUT_MODE=hosted

# ──────────────────────────────────────────────────────────────────────────
# Permissions
# ──────────────────────────────────────────────────────────────────────────
PERMISSIONS_PROVIDER=casl
OPENFGA_API_URL=

# ──────────────────────────────────────────────────────────────────────────
# Notifications
# ──────────────────────────────────────────────────────────────────────────
NOTIFICATION_PROVIDER=novu
NOVU_API_KEY=
KNOCK_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Supabase (when using Supabase for storage / auth)
# ──────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────────────────────────────
# AI gateway — provider chain + LLM proxy URLs
# ──────────────────────────────────────────────────────────────────────────
AI_GATEWAY_BASE_URL=
AI_GATEWAY_PROVIDER_CHAIN=
AI_GATEWAY_UPSTREAMS=
AI_CUSTOM_PROVIDER=
AI_CUSTOM_BASE_URL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LITELLM_BASE_URL=
PORTKEY_BASE_URL=

# ──────────────────────────────────────────────────────────────────────────
# Vault (envelope encryption for customer secrets)
# ──────────────────────────────────────────────────────────────────────────
VAULT_PROVIDER=hkdf
VAULT_MASTER_KEY=your-32-byte-hex-master-key-here

# ──────────────────────────────────────────────────────────────────────────
# Observability — Sentry + PostHog
# ──────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_RELEASE=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEBUTRA_TELEMETRY=true
NEBUTRA_POSTHOG_KEY=
NEBUTRA_POSTHOG_HOST=

# ──────────────────────────────────────────────────────────────────────────
# Redis backward-compatible aliases (still accepted by the gateway)
# ──────────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ──────────────────────────────────────────────────────────────────────────
# Misc gateway flags
# ──────────────────────────────────────────────────────────────────────────
SERVICE_SECRET=your-internal-service-secret-here
S2S_ALLOW_LEGACY=false
SKIP_ENV_VALIDATION=false
FEATURE_FLAG_BILLING=true
AGENT_ROLLOUT_DURABLE=false

# ──────────────────────────────────────────────────────────────────────────
# China SMS providers
# ──────────────────────────────────────────────────────────────────────────
ALIYUN_SMS_ACCESS_KEY_ID=
TENCENT_SMS_SECRET_ID=
