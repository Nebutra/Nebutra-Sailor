diff --git a/lib/guard.js b/lib/guard.js
new file mode 100644
index 0000000000000000000000000000000000000000..5df229abfd9c8dc0ba74c132d14d654358e67ed6
--- /dev/null
+++ b/lib/guard.js
@@ -0,0 +1,23 @@
+"use strict";
+
+// Iterative validation keeps attacker-controlled ASTs out of recursive walkers.
+module.exports = ast => {
+  const pending = [{ node: ast, depth: 0, leaving: false }];
+  const active = new Set();
+  let count = 0;
+  while (pending.length) {
+    const { node, depth, leaving } = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (leaving) { active.delete(node); continue; }
+    if (depth >= 128) throw new SyntaxError('braces nesting limit exceeded');
+    if (active.has(node)) throw new SyntaxError('braces cyclic AST rejected');
+    if (++count > 100000) throw new SyntaxError('braces AST node limit exceeded');
+    active.add(node);
+    pending.push({ node, depth, leaving: true });
+    if (Array.isArray(node.nodes)) {
+      for (let i = node.nodes.length - 1; i >= 0; i--) {
+        pending.push({ node: node.nodes[i], depth: depth + 1, leaving: false });
+      }
+    }
+  }
+};
