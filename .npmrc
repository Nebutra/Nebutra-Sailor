# Hoist all packages to root node_modules for Docker build compatibility.
# Without this, workspace package transitive deps (prisma, @upstash/redis,
# pino, @opentelemetry/*) are only in the pnpm virtual store and not
# resolvable by tsc or other tools in Docker multi-stage builds.
public-hoist-pattern[]=*
package-manager-strict=true
package-manager-strict-version=true
verify-deps-before-run=error

# Allow next-auth@5.x beta releases that ship without provenance. pnpm 10
# defaults `trust-policy=no-downgrade`, which rejects any version where
# an earlier release had stronger trust evidence. next-auth's beta cadence
# drops + adds provenance between releases, so the default flagged ECS
# builds with ERR_PNPM_TRUST_DOWNGRADE for `next-auth@5.0.0-beta.31`.
# Move to `permissive` until next-auth stabilizes attestations on v5 GA.
# Other supply-chain protection (audit-level, signatures, lockfile guard)
# stays in force.
trust-policy=permissive
