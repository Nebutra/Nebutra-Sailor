{
  "name": "@nebutra/sailor-docs",
  "version": "0.1.7",
  "private": true,
  "nebutra": {
    "status": "foundation",
    "graph": "core",
    "productionReady": false
  },
  "scripts": {
    "predev": "fumadocs-mdx",
    "dev": "next dev --port 3004",
    "prebuild": "fumadocs-mdx",
    "build": "_FUMADOCS_MDX=1 next build",
    "build:vm": "fumadocs-mdx && _FUMADOCS_MDX=1 next build --webpack",
    "start": "next start",
    "build:static": "fumadocs-mdx && SAILOR_DOCS_OUTPUT=export _FUMADOCS_MDX=1 next build && node scripts/postbuild-static-export.mjs",
    "typecheck": "fumadocs-mdx && _FUMADOCS_MDX=1 node ../../scripts/next-typegen-guard.mjs && tsc --noEmit",
    "lint:links": "node ./scripts/lint-links.mjs",
    "clean": "rm -rf .next .open-next .wrangler out dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@fumadocs/mdx-remote": "^1.4.6",
    "@fumadocs/story": "^0.0.11",
    "@nebutra/brand": "workspace:*",
    "@nebutra/fonts": "workspace:*",
    "@nebutra/health": "workspace:*",
    "@nebutra/icons": "workspace:*",
    "@nebutra/tokens": "workspace:*",
    "@nebutra/ui": "workspace:*",
    "@orama/orama": "^3.1.18",
    "@takumi-rs/image-response": "^0.71.4",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^12.35.0",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "fumadocs-mermaid": "^1.3.1",
    "fumadocs-obsidian": "^0.0.13",
    "fumadocs-openapi": "^10.3.17",
    "fumadocs-python": "^0.0.9",
    "fumadocs-typescript": "^5.1.5",
    "fumadocs-ui": "catalog:",
    "geist": "catalog:",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "mermaid": "^11.15.0",
    "next": "^16.2.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.7.1",
    "rehype-mermaid": "^3.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "unist-util-visit": "^5.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jiti": "^2.6.1",
    "next-validate-link": "^1.6.4",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.112.0"
  },
  "license": "FSL-1.1-ALv2"
}
