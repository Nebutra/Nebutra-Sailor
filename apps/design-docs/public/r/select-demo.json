{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "select-demo",
  "type": "registry:example",
  "dependencies": [
    "@nebutra/ui"
  ],
  "registryDependencies": [
    "@nebutra/ui"
  ],
  "files": [
    {
      "path": "registry/examples/select-demo.tsx",
      "content": "\"use client\";\n\nimport {\n  Select,\n  SelectContent,\n  SelectGroup,\n  SelectItem,\n  SelectLabel,\n  SelectTrigger,\n  SelectValue,\n} from \"@nebutra/ui/primitives\";\n\nexport function SelectDemo() {\n  return (\n    <div className=\"grid w-full max-w-[var(--select-demo-width)] gap-1.5 [--select-demo-width:240px]\">\n      <label\n        id=\"framework-label\"\n        className=\"font-medium text-foreground text-sm\"\n        htmlFor=\"framework-trigger\"\n      >\n        Framework\n      </label>\n      <Select>\n        <SelectTrigger id=\"framework-trigger\" aria-labelledby=\"framework-label\">\n          <SelectValue placeholder=\"Select a framework\" />\n        </SelectTrigger>\n        <SelectContent>\n          <SelectGroup>\n            <SelectLabel>Frameworks</SelectLabel>\n            <SelectItem value=\"nextjs\">Next.js</SelectItem>\n            <SelectItem value=\"react\">React</SelectItem>\n            <SelectItem value=\"sveltekit\">SvelteKit</SelectItem>\n          </SelectGroup>\n        </SelectContent>\n      </Select>\n    </div>\n  );\n}\n",
      "type": "registry:example"
    }
  ]
}
