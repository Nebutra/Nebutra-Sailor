# Sleptons — env template.
#
# Database: sleptons is a platform product app, so it consumes the SHARED
# platform Supabase Postgres via @nebutra/db (getSystemDb). It has NO own Prisma
# schema — its tables (sleptons_member_profiles / sleptons_products /
# sleptons_upvotes / sleptons_connections) live in the platform schema. Point
# DATABASE_URL at the SAME Supabase project as apps/web — never at Neon. Sleptons
# uses the system (BYPASSRLS) client, so it does NOT set APP_DB_ROLE.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
