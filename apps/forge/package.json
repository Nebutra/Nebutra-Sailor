{
  "name": "@nebutra/forge",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3105",
    "build": "pnpm --filter @nebutra/brand sync && next build --experimental-build-mode compile",
    "build:full": "pnpm --filter @nebutra/brand sync && next build",
    "start": "next start",
    "typecheck": "node ../../scripts/next-typegen-guard.mjs && tsc --noEmit",
    "test": "vitest run",
    "playwright:install": "playwright install chromium",
    "playwright:install:deps": "playwright install --with-deps chromium",
    "md-to-pdf:verify": "node ./scripts/verify-md-to-pdf.mjs"
  },
  "dependencies": {
    "@nebutra/ai-providers": "workspace:*",
    "@nebutra/auth": "workspace:*",
    "@nebutra/billing": "workspace:*",
    "@nebutra/brand": "workspace:*",
    "@nebutra/fonts": "workspace:*",
    "@nebutra/forge-runtime": "workspace:*",
    "@nebutra/i18n": "workspace:*",
    "@nebutra/icons": "workspace:*",
    "@nebutra/prepaid-wallet": "workspace:*",
    "@nebutra/tokens": "workspace:*",
    "@nebutra/ui": "workspace:*",
    "geist": "catalog:",
    "mermaid": "catalog:",
    "next": "catalog:",
    "next-intl": "^4.12.0",
    "playwright": "^1.58.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "^0.35.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "AGPL-3.0-only"
}
