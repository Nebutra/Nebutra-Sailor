NEXT_PUBLIC_SITE_URL="https://kuanlan.nebutra.com"
NEXT_PUBLIC_AUTH_PROVIDER="better-auth"
NEXT_PUBLIC_AUTH_URL="https://auth.nebutra.com"
BETTER_AUTH_URL="https://auth.nebutra.com"
BETTER_AUTH_SECRET=""
AUTH_COOKIE_DOMAIN=".nebutra.com"
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_ASSETS="nebutra-assets"
R2_BUCKET_UPLOADS="nebutra-uploads"
R2_PUBLIC_URL="https://cdn.nebutra.com"
NEXT_PUBLIC_R2_PUBLIC_URL="https://cdn.nebutra.com"
ROUTER_API_KEY=""
IMAGE2_BASE_URL="https://router.nebutra.com/v1"
IMAGE2_MODEL="gpt-image-2"

# 开拍上限（每人）。留空用保守默认：3 张/分钟、20 张/天。
# 桶在进程内，单机部署下是真实限制；重启会重置。
KUANLAN_SHOOT_BURST=""
KUANLAN_SHOOT_DAILY=""

# PlanetScale Postgres, through the PgBouncer pooler (port 6432). Fly has no
# Hyperdrive, so this is the only way in. Set on Fly by the
# "Ops — give kuanlan its database URL" workflow; deploy-fly.yml carries it too.
# No DIRECT_URL on purpose: the schema is owned by packages/platform/db and this
# app must never run a migration.
DATABASE_URL=""
# A role name, not a secret. @nebutra/db issues SET LOCAL ROLE with it inside
# every tenant transaction; unset, queries run as the connection's own role.
APP_DB_ROLE="app_user"

# 一次开拍扣多少 credit（1 credit = $0.01）。留空用默认 100。
KUANLAN_SHOOT_PRICE_CREDITS=""
