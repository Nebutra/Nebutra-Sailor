{
  "name": "@nebutra/status-app",
  "version": "0.1.0",
  "private": true,
  "description": "Nebutra Status — self-hostable status pages: evidence-based components, incidents, maintenance, subscribers",
  "nebutra": {
    "status": "wip",
    "graph": "labs",
    "productionReady": false
  },
  "scripts": {
    "dev": "next dev --port 3140",
    "build": "prisma generate && next build",
    "start": "next start --port 3140",
    "db:generate": "prisma generate",
    "db:migration": "node scripts/write-migration.mjs",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run"
  },
  "dependencies": {
    "@nebutra/fonts": "workspace:*",
    "@nebutra/icons": "workspace:*",
    "@nebutra/status": "workspace:*",
    "@nebutra/tokens": "workspace:*",
    "@nebutra/ui": "workspace:*",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "catalog:",
    "next": "catalog:",
    "next-intl": "^4.12.0",
    "nodemailer": "^9.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@electric-sql/pglite-socket": "^0.0.20",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "prisma": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "FSL-1.1-ALv2"
}
