ANTHROPIC_API_KEY=

# GitHub OAuth
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth
GOOGLE_ID=
GOOGLE_SECRET=

# Linux DO Connect OAuth
LINUXDO_ID=
LINUXDO_SECRET=

# Database — tsekaluk-dev runs on its OWN Neon Postgres (the platform product apps
# use Supabase; this dev/personal site is the deliberate exception). It has its own
# Prisma schema at apps/tsekaluk-dev/prisma/ and a null-tolerant client, so a
# placeholder is fine for DB-less local dev; the real Neon URL is set in the deploy env.
DATABASE_URL=postgresql://[USER]:[YOUR-PASSWORD]@[ENDPOINT]-pooler.[REGION].aws.neon.tech/[DB]?sslmode=require

# Admin
ADMIN_EMAIL=

# GitHub API (for metrics widget)
GITHUB_TOKEN=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@tsekaluk.dev

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Vercel Blob (avatar uploads)
BLOB_READ_WRITE_TOKEN=

# Langfuse (LLM observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Auth (Better Auth)
AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Discourse SSO (community bridge) — leave blank to disable
DISCOURSE_URL=
DISCOURSE_SSO_SECRET=
