# @nebutra/admin — ecosystem control plane
#
# The control plane ships to the ECS origin behind Cloudflare Access, so the
# deploy target is `standalone`, not `vercel`. Leaving this unset makes the Fleet
# page report the app as drifting from its own runtime (which is accurate — the
# frontend default is `vercel`).
DEPLOY_TARGET_ADMIN=standalone

# Phase 2 — OIDC relying party against the permanent issuer. The client row
# lives in OAuthClient; the secret is issued at registration time.
# OIDC_ISSUER=https://sso.example.com
# ADMIN_OIDC_CLIENT_ID=
# ADMIN_OIDC_CLIENT_SECRET=

# Phase 2 — gateway calls are made with a short-lived S2S JWT carrying the staff
# subject and role. X-Admin-Key stays machine-to-machine only.
# NEXT_PUBLIC_API_URL=https://api.example.com
# S2S_SIGNING_KEY=

# Admin Contract (nebutra.admin/v1). Every call to a product's manifest
# endpoints is signed with a short-lived HS256 service token carrying the
# caller's staff role. Must equal SERVICE_SECRET on the product (router).
# SERVICE_SECRET=
# Override a product origin for local development (default https://<brand.domains.router>).
# ADMIN_MANIFEST_ORIGIN_ROUTER=http://localhost:3106
