# Nebutra IdP local/production environment

# Local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nebutra?schema=public"
REDIS_URL="redis://localhost:6379"
OIDC_ISSUER="http://localhost:3100"
OIDC_COOKIE_KEYS="dev-cookie-key-1,dev-cookie-key-2"
OIDC_ENABLE_CLIENT_CREDENTIALS="false"

# Production
# DATABASE_URL="postgresql://..."
# REDIS_URL="redis://..."
# OIDC_ISSUER="https://sso.nebutra.com"
# OIDC_COOKIE_KEYS="<base64-48+>,<rotated-base64-48+>"
# OIDC_ENABLE_CLIENT_CREDENTIALS="false"
