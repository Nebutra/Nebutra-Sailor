# Where this deployment lives. Required in every deployed environment — the auth center returns here.
NEXT_PUBLIC_SITE_URL="https://para.example.com"

# Auth center, shared with the other product edges.
NEXT_PUBLIC_AUTH_PROVIDER="better-auth"
NEXT_PUBLIC_AUTH_URL="https://auth.example.com"

# Gateway origin. Unset -> the shell runs standalone on mock data and never calls the API.
NEXT_PUBLIC_PARA_API_URL="https://api.example.com"

# Show timeline / viewer, which are EXPERIMENTAL and have no implementation yet.
# NEXT_PUBLIC_PARA_LABS="1"
