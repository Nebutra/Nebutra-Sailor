    "fumadocs-ui": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fontsource/noto-sans-sc": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "^22.19.15",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "geist": "catalog:",
    "opentype.js": "2.0.0",
    "sharp": "^0.35.5",
    "shiki": "4.4.3",
    "tailwindcss": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.8.3"
  }
