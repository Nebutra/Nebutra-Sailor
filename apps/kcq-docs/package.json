{
  "name": "@nebutra/kcq-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "nebutra": {
    "status": "labs",
    "graph": "product",
    "productionReady": false
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "node scripts/generate.mjs && fumadocs-mdx && next dev --port 3014",
    "build": "node scripts/generate.mjs && fumadocs-mdx && next build && node scripts/postbuild.mjs",
    "typecheck": "node scripts/generate.mjs && fumadocs-mdx && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nebutra/brand": "workspace:*",
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "catalog:",
